# MySQL 配置
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=reggie

# 后端配置
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/reggie?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&zeroDateTimeBehavior=convertToNull&useSSL=false&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root123

# 豆包 AI 配置 (可选)
DOUBAO_API_KEY=9bb5f2c7-fec5-485e-ac5e-c1ce669667fb
DOUBAO_API_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
DOUBAO_MODEL=doubao-1-5-pro-32k-250115

# 端口配置
BACKEND_PORT=8080
ADMIN_PORT=3000
MERCHANT_PORT=3001
MYSQL_PORT=3306
REDIS_PORT=6379
