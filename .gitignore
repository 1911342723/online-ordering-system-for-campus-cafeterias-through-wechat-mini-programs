.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Temporary files
*.tmp
*.temp
*~
*.swp
*.swo

# ==================== 上传文件/图片 ====================
# 用户上传的文件（但保留示例图片）
backend/src/main/resources/food_img/*
!backend/src/main/resources/food_img/.gitkeep
!backend/src/main/resources/food_img/*.jpg

# 前端静态资源（如果是动态生成的）
# frontend/user/assets/uploads/

# ==================== 配置文件 ====================
# 敏感配置文件（包含密码、密钥等）
application-prod.yml
application-dev.yml
# 保留示例配置
# !application.yml.example

# ==================== 其他 ====================
# 打包文件
*.rar
*.zip
*.7z
*.dmg
*.iso

# 测试覆盖率报告
coverage/
*.lcov
.nyc_output/

# 缓存
.cache/
*.cache

# ==================== 项目特定 ====================
# 构建产物
*.jar.original

# 本地测试数据
test-data/

# 文档草稿
docs/draft/
*.draft.md

# ==================== 保留文件说明 ====================
# 以下文件/文件夹会被保留：
# - backend/db.sql (初始数据库脚本)
# - backend/*.sql (数据库更新脚本)
# - backend/src/main/resources/application.yml (配置模板)
# - README.md (项目说明)
# - 所有源代码文件

