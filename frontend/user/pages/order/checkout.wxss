/* 下单页面样式 */
.container {
  padding: 20rpx;
  padding-bottom: 140rpx;
  background-color: #f8f8f8;
  min-height: 100vh;
}

.section {
  background-color: #fff;
  margin-bottom: 24rpx;
  padding: 30rpx;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.02);
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
}

.section-title::before {
  content: '';
  width: 6rpx;
  height: 28rpx;
  background: #ff6b00;
  border-radius: 4rpx;
  margin-right: 16rpx;
}

/* 配送方式 */
.delivery-methods {
  display: flex;
  gap: 20rpx;
}

.method-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  border: 2rpx solid #f0f0f0;
  border-radius: 16rpx;
  background: #fff;
  transition: all 0.3s;
  position: relative;
}

.method-item.active {
  border-color: #ff6b00;
  background-color: #fffbf8;
}

.method-item.active::after {
  content: '';
  position: absolute;
  right: 0;
  bottom: 0;
  width: 32rpx;
  height: 32rpx;
  background: #ff6b00;
  border-radius: 16rpx 0 16rpx 0;
  /* Checkmark using pseudo-element or icon would be better, simplistic here */
}
.method-item.active::before {
  content: '✓';
  position: absolute;
  right: 2rpx;
  bottom: 2rpx;
  font-size: 20rpx;
  color: #fff;
  z-index: 1;
}

.method-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.method-info {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.method-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 6rpx;
}

.method-desc {
  font-size: 22rpx;
  color: #999;
}

/* 地址选择 */
.address-selector {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
}

.address-info {
  flex: 1;
}

.address-top {
  display: flex;
  align-items: baseline;
  margin-bottom: 12rpx;
}

.name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-right: 20rpx;
}

.phone {
  font-size: 28rpx;
  color: #666;
}

.address-detail {
  font-size: 26rpx;
  color: #333;
  line-height: 1.4;
}

.address-placeholder {
  flex: 1;
  font-size: 30rpx;
  color: #999;
}

.arrow {
  font-size: 32rpx;
  color: #ccc;
  margin-left: 10rpx;
}

/* 优惠券选择 */
.coupon-selector {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.coupon-info {
  flex: 1;
}

.coupon-selected {
  font-size: 28rpx;
  color: #ff4d4f;
  font-weight: bold;
}

.coupon-placeholder {
  font-size: 28rpx;
  color: #999;
}

/* 订单明细 */
.order-items {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.order-item {
  display: flex;
  align-items: flex-start;
}

.item-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  background-color: #f5f5f5;
}

.item-info {
  flex: 1;
  height: 120rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.item-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.3;
}

.item-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.item-price {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.item-count {
  font-size: 26rpx;
  color: #999;
}

/* 费用明细 */
.fee-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.fee-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  color: #666;
}

.fee-item.discount {
  color: #ff4d4f;
}

.discount-amount {
  color: #ff4d4f;
  font-weight: bold;
}

.fee-item.total {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  padding-top: 24rpx;
  border-top: 2rpx dashed #eee;
  margin-top: 8rpx;
}

.total-amount {
  color: #ff4d4f;
  font-size: 36rpx;
}

/* 备注 */
.remark-input {
  width: 100%;
  height: 160rpx;
  padding: 20rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

/* 底部提交栏 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 110rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 0 30rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 100;
}

.total-info {
  display: flex;
  align-items: baseline;
  margin-right: 30rpx;
}

.label {
  font-size: 28rpx;
  color: #333;
  margin-right: 8rpx;
}

.price {
  font-size: 44rpx;
  font-weight: bold;
  color: #ff4d4f;
}

.price::before {
  content: '¥';
  font-size: 28rpx;
  margin-right: 2rpx;
}

.submit-btn {
  width: 240rpx;
  height: 76rpx;
  line-height: 76rpx;
  background: linear-gradient(135deg, #ff9c35 0%, #ff6b00 100%);
  color: #fff;
  border-radius: 38rpx;
  font-size: 30rpx;
  font-weight: bold;
  margin: 0;
  box-shadow: 0 6rpx 16rpx rgba(255, 107, 0, 0.25);
}

.submit-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}
