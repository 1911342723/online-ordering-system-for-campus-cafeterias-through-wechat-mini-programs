/* 下单页面样式 - 高级设计版本 */
page {
  background-color: var(--bg-color);
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

.container {
  padding: 24rpx;
}

/* 通用卡片样式 */
.section {
  background-color: var(--white);
  margin-bottom: 24rpx;
  padding: 32rpx;
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-md);
  border: 1px solid var(--border-light);
  animation: fadeIn 0.4s ease-out;
}

.section-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--text-main);
  margin-bottom: 28rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* 配送方式 */
.delivery-methods {
  display: flex;
  gap: 20rpx;
}

.method-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 28rpx 20rpx;
  border: 2rpx solid var(--border-color);
  border-radius: var(--radius-lg);
  background: var(--white);
  transition: all 0.2s;
  position: relative;
  overflow: hidden;
}

.method-item.active {
  border-color: var(--primary-color);
  background-color: #f0f9ff; /* Light blue tint */
}

.method-item.active::after {
  content: '';
  position: absolute;
  right: 0;
  bottom: 0;
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 0 0 40rpx 40rpx;
  border-color: transparent transparent var(--primary-color) transparent;
}

.method-item.active::before {
  content: '✓';
  position: absolute;
  right: 4rpx;
  bottom: 4rpx;
  font-size: 18rpx;
  color: #fff;
  z-index: 1;
  line-height: 1;
}

.method-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.method-info {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.method-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 4rpx;
}

.method-desc {
  font-size: 22rpx;
  color: var(--text-grey);
}

/* 地址选择 */
.address-selector {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}

.address-info {
  flex: 1;
  margin-right: 20rpx;
}

.address-top {
  display: flex;
  align-items: baseline;
  margin-bottom: 12rpx;
  gap: 16rpx;
}

.name {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--text-main);
}

.phone {
  font-size: 28rpx;
  color: var(--text-sub);
  font-family: 'SF Mono', monospace;
}

.address-detail {
  font-size: 28rpx;
  color: var(--text-main);
  line-height: 1.4;
}

.address-placeholder {
  flex: 1;
  font-size: 30rpx;
  color: var(--text-grey);
}

.arrow {
  font-size: 32rpx;
  color: var(--text-light);
}

/* 优惠券选择 */
.coupon-selector {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.coupon-info {
  flex: 1;
}

.coupon-selected {
  font-size: 28rpx;
  color: #e11d48;
  font-weight: 700;
}

.coupon-placeholder {
  font-size: 28rpx;
  color: var(--text-grey);
}

/* 订单明细 */
.order-items {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.order-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.item-image {
  width: 112rpx;
  height: 112rpx;
  border-radius: var(--radius-md);
  background-color: #f1f5f9;
  flex-shrink: 0;
}

.item-info {
  flex: 1;
  height: 112rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.item-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-main);
  line-height: 1.3;
}

.item-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.item-price {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-main);
}

.item-count {
  font-size: 26rpx;
  color: var(--text-grey);
}

/* 费用明细 */
.fee-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.fee-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  color: var(--text-sub);
}

.fee-item.discount {
  color: #e11d48;
}

.discount-amount {
  color: #e11d48;
  font-weight: 700;
}

.fee-item.total {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--text-main);
  padding-top: 24rpx;
  border-top: 2rpx dashed var(--border-light);
  margin-top: 8rpx;
}

.total-amount {
  color: #e11d48;
  font-size: 36rpx;
}

/* 备注 */
.remark-input {
  width: 100%;
  height: 160rpx;
  padding: 24rpx;
  background: #f8fafc;
  border-radius: var(--radius-lg);
  font-size: 28rpx;
  color: var(--text-main);
  box-sizing: border-box;
  border: 1px solid var(--border-light);
}

/* 底部提交栏 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: var(--white);
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 0 32rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 100;
}

.total-info {
  display: flex;
  align-items: baseline;
  margin-right: 32rpx;
}

.label {
  font-size: 28rpx;
  color: var(--text-main);
  margin-right: 8rpx;
  font-weight: 500;
}

.price {
  font-size: 48rpx;
  font-weight: 900;
  color: #e11d48;
}

.price::before {
  content: '¥';
  font-size: 28rpx;
  margin-right: 4rpx;
  font-weight: 700;
}

.submit-btn {
  width: 240rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
  color: #fff;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 700;
  margin: 0;
  box-shadow: 0 8rpx 20rpx rgba(14, 165, 233, 0.3);
  transition: all 0.2s;
}

.submit-btn:active {
  transform: scale(0.96);
  opacity: 0.95;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}
