<!-- 订单详情页 - 高级设计版本 -->
<view class="container">
  <!-- Status Header (Gradient Background) -->
  <view class="status-header">
    <view class="status-content">
      <view class="status-main">
        <!-- 使用更精美的状态图标 -->
        <view class="status-icon-wrapper" wx:if="{{orderInfo.status === 2}}">
          <text class="status-icon">🔥</text>
        </view>
        <view class="status-icon-wrapper cooking" wx:if="{{orderInfo.status === 3}}">
          <text class="status-icon">👨‍🍳</text>
        </view>
        <view class="status-icon-wrapper ready" wx:if="{{orderInfo.status === 4}}">
          <text class="status-icon">✨</text>
        </view>
        <view class="status-icon-wrapper done" wx:if="{{orderInfo.status === 5}}">
          <text class="status-icon">🎉</text>
        </view>
        <view class="status-icon-wrapper pending" wx:if="{{orderInfo.status === 1}}">
          <text class="status-icon">⏳</text>
        </view>
        <text class="status-text">{{statusText}}</text>
      </view>
      <view class="status-desc">{{statusDesc}}</view>
      
      <!-- Pickup Code (Large Card) - 精美取餐码 -->
      <view class="pickup-code-box" wx:if="{{orderInfo.status >= 2 && orderInfo.status <= 4}}">
        <view class="pickup-left">
          <text class="label">取餐码 / PICKUP CODE</text>
          <text class="code">{{orderInfo.pickupCode || 'A-888'}}</text>
        </view>
        <view class="qr-wrapper">
          <view class="qr-icon-modern">
            <text class="qr-dots">▣</text>
          </view>
          <text class="qr-hint">扫码取餐</text>
        </view>
      </view>
    </view>
  </view>

  <view class="content-wrapper">
    <!-- Delivery Address -->
    <view class="card" wx:if="{{orderInfo.deliveryType === 2}}">
      <view class="card-title">
        <view class="title-with-icon">
          <view class="title-icon location">📍</view>
          <text>配送信息</text>
        </view>
      </view>
      <view class="info-row">
        <text class="label">地址</text>
        <text class="value">{{orderInfo.address}}</text>
      </view>
      <view class="info-row">
        <text class="label">联系人</text>
        <text class="value">{{orderInfo.consignee}} {{orderInfo.phone}}</text>
      </view>
    </view>

    <!-- Order Items -->
    <view class="card">
      <view class="card-title">
        <view class="title-with-icon">
          <view class="title-icon package">📦</view>
          <text class="shop-name">商品清单</text>
        </view>
        <view class="contact-btn" bindtap="contactShop">
          <text>💬 联系商家</text>
        </view>
      </view>
      
      <view class="dish-list">
        <view class="dish-item" wx:for="{{dishList}}" wx:key="id">
          <image class="dish-image" src="{{item.image}}" mode="aspectFill"></image>
          <view class="dish-info">
            <text class="dish-name">{{item.name}}</text>
            <view class="dish-flavor" wx:if="{{item.dishFlavor}}">
              <text class="flavor-icon">🏷️</text>
              <text>{{item.dishFlavor}}</text>
            </view>
          </view>
          <view class="dish-right">
            <text class="dish-price">¥{{item.amount}}</text>
            <text class="dish-count">×{{item.number}}</text>
          </view>
        </view>
      </view>
      
      <view class="divider"></view>
      
      <!-- Fees -->
      <view class="fee-list">
        <view class="fee-item">
          <text>商品总价</text>
          <text>¥{{dishAmount}}</text>
        </view>
        <view class="fee-item" wx:if="{{orderInfo.deliveryFee > 0}}">
          <text>配送费</text>
          <text>¥{{orderInfo.deliveryFee}}</text>
        </view>
        <view class="fee-item discount" wx:if="{{orderInfo.discount > 0}}">
          <text>🎁 优惠</text>
          <text class="discount-amount">-¥{{orderInfo.discount}}</text>
        </view>
        <view class="fee-item total">
          <text class="total-label">实付金额</text>
          <text class="total-amount">¥{{orderInfo.amount}}</text>
        </view>
      </view>
    </view>

    <!-- Order Info -->
    <view class="card">
      <view class="card-title">
        <view class="title-with-icon">
          <view class="title-icon info">📋</view>
          <text>订单信息</text>
        </view>
      </view>
      <view class="info-list">
        <view class="info-row">
          <text class="label">订单号码</text>
          <view class="value-copy" bindtap="copyOrderNumber">
            <text class="order-number">{{orderInfo.number}}</text>
            <view class="copy-btn">
              <text>复制</text>
            </view>
          </view>
        </view>
        <view class="info-row">
          <text class="label">下单时间</text>
          <text class="value">{{orderInfo.orderTime}}</text>
        </view>
        <view class="info-row" wx:if="{{orderInfo.payTime}}">
          <text class="label">支付时间</text>
          <text class="value">{{orderInfo.payTime}}</text>
        </view>
        <view class="info-row" wx:if="{{orderInfo.remark}}">
          <text class="label">备注</text>
          <text class="value remark">{{orderInfo.remark}}</text>
        </view>
      </view>
    </view>
  </view>
</view>

<!-- Floating Footer -->
<view class="footer-actions" wx:if="{{orderInfo.status === 1 || orderInfo.status === 5}}">
  <view class="footer-content">
    <block wx:if="{{orderInfo.status === 1}}">
      <button class="action-btn outline" bindtap="cancelOrder">
        <text>取消订单</text>
      </button>
      <button class="action-btn primary" bindtap="goPay">
        <text>💳 立即支付</text>
      </button>
    </block>
    <block wx:if="{{orderInfo.status === 5}}">
      <button class="action-btn outline" bindtap="goReview">
        <text>⭐ 评价</text>
      </button>
      <button class="action-btn primary" bindtap="reorder">
        <text>🔄 再来一单</text>
      </button>
    </block>
  </view>
</view>
