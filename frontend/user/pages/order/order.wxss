/* pages/order/order.wxss */
page {
  background-color: var(--bg-color);
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.tabs {
  display: flex;
  background: var(--white);
  padding: 0 0 20rpx;
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: var(--shadow-sm);
}

.tab {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: var(--text-sub);
  position: relative;
  padding: 24rpx 0 20rpx;
  white-space: nowrap;
  transition: all 0.3s;
}

.tab.active {
  color: var(--primary-color);
  font-weight: 700;
  font-size: 30rpx;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background-color: var(--primary-color);
  border-radius: 4rpx;
}

.order-list {
  flex: 1;
  padding: 24rpx 30rpx;
  box-sizing: border-box;
}

.order-card {
  background: var(--white);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
}

.card-header {
  display: flex;
  justify-content: space-between;
  border-bottom: 1rpx solid #f5f5f5;
  padding-bottom: 20rpx;
  margin-bottom: 20rpx;
  align-items: center;
}

.shop-name {
  font-weight: 700;
  font-size: 30rpx;
  color: var(--text-main);
}

.status {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 24rpx;
  font-weight: 500;
}

/* 订单状态颜色 */
.status-1 { /* 待付款 */
  color: #FF5000;
  background-color: rgba(255, 80, 0, 0.1);
}

.status-2 { /* 制作中 */
  color: #FF8F40;
  background-color: rgba(255, 143, 64, 0.1);
}

.status-3 { /* 配送中 */
  color: #1890FF;
  background-color: rgba(24, 144, 255, 0.1);
}

.status-4 { /* 已完成 */
  color: #52C41A;
  background-color: rgba(82, 196, 26, 0.1);
}

.status-5 { /* 已取消 */
  color: #999;
  background-color: #F5F5F5;
}

.card-body {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.order-items {
  display: flex;
  align-items: center;
  flex: 1;
  max-width: 65%;
}

.order-img {
  width: 96rpx;
  height: 96rpx;
  background: #f0f0f0;
  margin-right: 24rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.item-desc {
  display: flex;
  flex-direction: column;
  flex: 1;
  overflow: hidden;
}

.item-name {
  font-size: 28rpx;
  margin-bottom: 8rpx;
  color: var(--text-main);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-weight: 500;
}

.order-time {
  font-size: 24rpx;
  color: var(--text-sub);
}

.order-total {
  text-align: right;
  flex-shrink: 0;
}

.total-label {
  font-size: 24rpx;
  color: var(--text-sub);
  display: block;
  margin-bottom: 4rpx;
}

.total-amount {
  font-weight: 800;
  font-size: 36rpx;
  color: var(--text-main);
}

.card-footer {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
}

.card-footer button {
  margin: 0;
  font-size: 26rpx;
  border-radius: 32rpx;
  padding: 0 32rpx;
  line-height: 2;
}

.card-footer button[plain] {
  border: 1rpx solid #ddd;
  color: #666;
}

.card-footer .btn-primary {
  background: linear-gradient(135deg, #FF7A30, #FF5000);
  color: #fff;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(255, 80, 0, 0.2);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 100rpx;
  color: var(--text-sub);
}

.empty-img {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 20rpx;
  opacity: 0.6;
}

