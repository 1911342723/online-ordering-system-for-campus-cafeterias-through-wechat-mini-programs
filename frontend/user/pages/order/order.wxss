/* pages/order/order.wxss */
page {
  background-color: #f8f8f8;
  min-height: 100vh;
}

.container {
  display: flex;
  flex-direction: column;
}

.tabs {
  display: flex;
  background: #fff;
  padding: 0 0 10rpx;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.tab {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  position: relative;
  padding: 24rpx 0 20rpx;
  white-space: nowrap;
  transition: all 0.3s;
}

.tab.active {
  color: #FF6B00;
  font-weight: bold;
  font-size: 30rpx;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background-color: #FF6B00;
  border-radius: 4rpx;
}

/* 移除scroll-view样式，改为普通布局 */
.order-list {
  padding: 24rpx 30rpx;
  padding-bottom: 120rpx; /* 底部留白 */
}

.order-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.card-header {
  display: flex;
  justify-content: space-between;
  border-bottom: 1rpx solid #f5f5f5;
  padding-bottom: 20rpx;
  margin-bottom: 20rpx;
  align-items: center;
}

.shop-name {
  font-weight: bold;
  font-size: 30rpx;
  color: #333;
}

.status {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 24rpx;
  font-weight: 500;
}

/* 订单状态颜色 */
.status-1 { /* 待付款 */
  color: #FF5000;
  background-color: rgba(255, 80, 0, 0.1);
}

.status-2 { /* 制作中 */
  color: #FF8F40;
  background-color: rgba(255, 143, 64, 0.1);
}

.status-3 { /* 配送中 */
  color: #1890FF;
  background-color: rgba(24, 144, 255, 0.1);
}

.status-4 { /* 已完成 */
  color: #52C41A;
  background-color: rgba(82, 196, 26, 0.1);
}

.status-5 { /* 已取消 */
  color: #999;
  background-color: #F5F5F5;
}

.card-body {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.order-items {
  display: flex;
  align-items: center;
  flex: 1;
  max-width: 65%;
}

.order-img {
  width: 120rpx;
  height: 120rpx;
  background: #f8f8f8;
  margin-right: 24rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.item-desc {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  flex: 1;
  height: 120rpx;
  padding: 4rpx 0;
}

.item-name {
  font-size: 28rpx;
  margin-bottom: 8rpx;
  color: #333;
  font-weight: bold;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.order-time {
  font-size: 22rpx;
  color: #999;
}

.order-total {
  text-align: right;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.total-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.total-amount {
  font-weight: 800;
  font-size: 36rpx;
  color: #333;
}

.card-footer {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  border-top: 1rpx solid #f9f9f9;
  padding-top: 20rpx;
}

.card-footer button {
  margin: 0;
  font-size: 26rpx;
  border-radius: 32rpx;
  padding: 0 32rpx;
  line-height: 2.2;
}

.card-footer button[plain] {
  border: 1rpx solid #ddd;
  color: #666;
  background: transparent;
}

.card-footer .btn-primary {
  background: linear-gradient(135deg, #FF8C00, #FF6B00);
  color: #fff;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 0, 0.2);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 200rpx;
  color: #999;
}

.empty-img {
  width: 300rpx;
  height: 300rpx;
  margin-bottom: 30rpx;
  opacity: 0.8;
}

.loading-more, .no-more {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 24rpx;
}
