/* 订单详情页样式 */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 120rpx;
}

/* 订单状态 */
.status-section {
  padding: 60rpx 30rpx;
  text-align: center;
  color: #fff;
}

/* 不同状态的背景色 */
.status-section.status-1 {
  background: linear-gradient(135deg, #FF6B00, #FF8F3D);
}

.status-section.status-2 {
  background: linear-gradient(135deg, #2196F3, #42A5F5);
}

.status-section.status-3 {
  background: linear-gradient(135deg, #4CAF50, #66BB6A);
}

.status-section.status-4 {
  background: linear-gradient(135deg, #666, #888);
}

.status-section.status-5 {
  background: linear-gradient(135deg, #F44336, #EF5350);
}

.status-text {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.status-desc {
  font-size: 26rpx;
  opacity: 0.9;
}

/* 通用section */
.section {
  background-color: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
}

/* 信息项 */
.info-item {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-item:last-child {
  border-bottom: none;
}

.info-item .label {
  font-size: 28rpx;
  color: #666;
}

.info-item .value {
  font-size: 28rpx;
  color: #333;
  text-align: right;
  flex: 1;
  margin-left: 40rpx;
}

/* 商品列表 */
.dish-list {
  border-top: 1rpx solid #f5f5f5;
  padding-top: 20rpx;
}

.dish-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.dish-item:last-child {
  border-bottom: none;
}

.dish-image {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  background-color: #f5f5f5;
  flex-shrink: 0;
}

.dish-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.dish-name {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.dish-flavor {
  font-size: 24rpx;
  color: #999;
}

.dish-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.dish-price {
  font-size: 28rpx;
  color: #FF6B00;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.dish-count {
  font-size: 24rpx;
  color: #999;
}

/* 费用明细 */
.fee-list {
  border-top: 1rpx solid #f5f5f5;
  padding-top: 20rpx;
}

.fee-item {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #666;
}

.fee-item.total {
  border-top: 1rpx solid #f5f5f5;
  margin-top: 12rpx;
  padding-top: 20rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.fee-item.total .amount {
  color: #FF6B00;
  font-size: 36rpx;
}

/* 底部按钮 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  padding: 20rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  display: flex;
  gap: 20rpx;
}

.pay-btn {
  flex: 1;
  height: 88rpx;
  background: linear-gradient(135deg, #FF6B00, #FF8F3D);
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
  line-height: 88rpx;
}

.pay-btn::after {
  border: none;
}

.review-btn {
  flex: 1;
  height: 88rpx;
  background: #fff;
  color: #FF6B00;
  border: 2rpx solid #FF6B00;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: bold;
  line-height: 84rpx;
}
