<!--pages/order/order.wxml-->
<view class="container">
  <!-- Sticky Header with Tabs -->
  <view class="header-tabs">
    <scroll-view scroll-x class="tabs-scroll" show-scrollbar="{{false}}">
      <view class="tabs-wrapper">
        <view class="tab {{currentTab==0 ? 'active' : ''}}" bindtap="switchTab" data-index="0">全部</view>
        <view class="tab {{currentTab==1 ? 'active' : ''}}" bindtap="switchTab" data-index="1">待付款</view>
        <view class="tab {{currentTab==2 ? 'active' : ''}}" bindtap="switchTab" data-index="2">进行中</view>
        <view class="tab {{currentTab==4 ? 'active' : ''}}" bindtap="switchTab" data-index="4">已完成</view>
      </view>
    </scroll-view>
  </view>

  <scroll-view scroll-y class="order-scroll" refresher-enabled bindrefresherrefresh="onPullDownRefresh" bindscrolltolower="onReachBottom" refresher-triggered="{{isRefreshing}}">
    <view class="order-list">
      <block wx:if="{{orders.length > 0}}">
        <block wx:for="{{orders}}" wx:key="id">
          
          <!-- Active Order Card (Status 2: Waiting, 3: Preparing, 4: Delivering) -->
          <view class="active-card" wx:if="{{item.status === 2 || item.status === 3 || item.status === 4}}" bindtap="viewOrderDetail" data-id="{{item.id}}">
            <!-- Status Ribbon -->
            <view class="status-ribbon">
              {{item.statusText}}
            </view>
            
            <view class="card-content">
              <view class="shop-info-row">
                <image src="{{item.image || defaultOrderImg}}" class="shop-avatar" mode="aspectFill"></image>
                <view class="shop-text">
                  <view class="shop-name">{{item.shopName}}</view>
                  <view class="wait-time">预计等待 <text class="highlight">15分钟</text></view>
                </view>
              </view>

              <!-- Fake Progress Bar -->
              <view class="progress-section">
                <view class="progress-bar">
                  <view class="progress-fill" style="width: {{item.status === 2 ? '33%' : (item.status === 3 ? '66%' : '100%')}}"></view>
                </view>
                <view class="progress-labels">
                  <text class="{{item.status >= 2 ? 'active' : ''}}">已下单</text>
                  <text class="{{item.status >= 3 ? 'active' : ''}}">制作中</text>
                  <text class="{{item.status >= 4 ? 'active' : ''}}">配送中</text>
                </view>
              </view>

              <view class="divider-dashed"></view>

              <!-- Delivery Code -->
              <view class="pickup-section">
                <view class="pickup-left">
                  <text class="pickup-label">配送单号</text>
                  <text class="pickup-code">{{item.pickupCode || '--'}}</text>
                </view>
                <view class="qr-icon-box">
                  <view class="qr-modern">
                    <text class="qr-symbol">▣</text>
                  </view>
                </view>
              </view>
            </view>
            
            <!-- Footer Actions -->
            <view class="card-footer-action">
              <view class="total-info">
                <text class="label">合计</text>
                <text class="amount">¥{{item.amount}}</text>
              </view>
              <button class="btn-contact" catchtap="contactShop" data-merchant-id="{{item.merchantId}}" data-merchant-name="{{item.shopName}}" data-order-id="{{item.id}}" data-order-number="{{item.orderNumber}}">联系商家</button>
            </view>
          </view>

          <!-- Simple History/Pending Card (Status 1: Pending, 5: Completed, 6: Cancelled) -->
          <view class="history-card" wx:else bindtap="viewOrderDetail" data-id="{{item.id}}">
            <view class="history-header">
              <text class="history-shop">{{item.shopName}}</text>
              <text class="history-status status-{{item.status}}">{{item.statusText}}</text>
            </view>
            <view class="history-body">
              <text class="history-desc">{{item.firstDishName}}</text>
              <text class="history-amount">¥{{item.amount}}</text>
            </view>
            <view class="history-footer">
               <button size="mini" plain class="btn-outline" wx:if="{{item.status === 1}}" catchtap="goPay" data-id="{{item.id}}">去支付</button>
               <button size="mini" class="btn-reorder" wx:if="{{item.status === 5}}" catchtap="reorder" data-id="{{item.id}}">再来一单</button>
            </view>
          </view>

        </block>

        <!-- Loading More -->
        <view class="loading-more" wx:if="{{isLoading}}">
          <text>加载中...</text>
        </view>
        <view class="no-more" wx:if="{{!hasMore && orders.length > 0}}">
          <text>没有更多了</text>
        </view>
      </block>

      <!-- Empty State -->
      <view wx:else class="empty-state">
        <image src="/assets/icons/no_order.png" class="empty-img" mode="aspectFit"></image> 
        <text>暂无订单</text>
        <button class="btn-go-shop" bindtap="goToIndex">去点餐</button>
      </view>
    </view>
  </scroll-view>
</view>
