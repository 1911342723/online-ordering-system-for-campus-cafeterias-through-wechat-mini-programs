/* 购物车页面样式 */
.container {
  height: 100vh;
  background-color: var(--bg-color);
}

/* 空购物车 */
.empty-cart {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-icon {
  width: 300rpx;
  height: 300rpx;
  margin-bottom: 40rpx;
  opacity: 0.8;
}

.empty-text {
  font-size: 32rpx;
  color: var(--text-sub);
  margin-bottom: 60rpx;
}

.go-shopping-btn {
  padding: 24rpx 80rpx;
  background: linear-gradient(135deg, #FF7A30, #FF5000);
  color: #fff;
  border: none;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 20rpx rgba(255, 80, 0, 0.25);
  transition: all 0.3s ease;
}

.go-shopping-btn:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 10rpx rgba(255, 80, 0, 0.15);
}

/* 购物车内容 */
.cart-content {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.cart-list {
  flex: 1;
  padding: 20rpx 30rpx;
  padding-bottom: 140rpx;
}

.cart-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 24rpx;
  background-color: var(--white);
  border-radius: 20rpx;
  box-shadow: var(--shadow-sm);
}

.item-checkbox {
  margin-right: 20rpx;
  transform: scale(1.1);
}

.item-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin-right: 24rpx;
  background-color: #f5f5f5;
}

.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 160rpx;
}

.item-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-flavor {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-bottom: 16rpx;
}

.item-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: auto;
}

.item-price {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--primary-color);
}

.item-price::before {
  content: '¥';
  font-size: 26rpx;
  font-weight: normal;
  margin-right: 2rpx;
}

/* 数量步进器 */
.stepper {
  display: flex;
  align-items: center;
  border: 1rpx solid #eee;
  border-radius: 30rpx;
  overflow: hidden;
  background-color: #f9f9f9;
}

.stepper-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #666;
  background-color: transparent;
  transition: background-color 0.2s;
}

.stepper-btn:active {
  background-color: #eee;
}

.stepper-btn.minus {
  border-right: 1rpx solid #eee;
}

.stepper-btn.plus {
  border-left: 1rpx solid #eee;
  color: var(--primary-color);
  font-weight: bold;
}

.stepper-num {
  min-width: 60rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--text-main);
  font-weight: 600;
}

/* 底部结算栏 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 30rpx;
  background-color: var(--white);
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
  padding-bottom: env(safe-area-inset-bottom);
}

.select-all {
  display: flex;
  align-items: center;
}

.select-all checkbox {
  transform: scale(1.1);
  margin-right: 16rpx;
}

.select-all-text {
  font-size: 28rpx;
  color: var(--text-main);
  font-weight: 500;
}

.total-section {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.total-info {
  display: flex;
  align-items: baseline;
}

.total-label {
  font-size: 28rpx;
  color: var(--text-main);
  margin-right: 8rpx;
}

.total-price {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--primary-color);
}

.checkout-btn {
  padding: 20rpx 48rpx;
  background: linear-gradient(135deg, #FF7A30, #FF5000);
  color: #fff;
  border: none;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(255, 80, 0, 0.3);
}

.checkout-btn[disabled] {
  background: #ccc;
  box-shadow: none;
}

