.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 40rpx;
  background-color: #fff;
}

.login-box {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 40rpx;
  background-color: #FF6B00;
  border-radius: 50%;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #333;
}

.subtitle {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
}

/* 重试提示 */
.retry-tip {
  width: 100%;
  background-color: #FFF3E0;
  border-left: 4rpx solid #FF6B00;
  padding: 20rpx;
  margin-bottom: 40rpx;
  border-radius: 8rpx;
}

.retry-text {
  font-size: 26rpx;
  color: #FF6B00;
}

/* 主登录按钮 */
.login-btn {
  width: 100%;
  background-color: #07c160;
  color: #fff;
  border-radius: 50rpx;
  padding: 20rpx 0;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.login-btn:active {
  opacity: 0.9;
}

/* 快捷登录区域 */
.quick-login-section {
  width: 100%;
  margin-top: 60rpx;
}

.divider {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.divider::before,
.divider::after {
  content: '';
  flex: 1;
  height: 1rpx;
  background: #e0e0e0;
}

.divider text {
  padding: 0 20rpx;
  font-size: 24rpx;
  color: #999;
}

.quick-login-buttons {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.quick-btn {
  width: 100%;
  padding: 20rpx 0;
  border-radius: 8rpx;
  border: none;
  font-size: 28rpx;
  font-weight: 500;
}

.student-btn {
  background-color: #f5f5f5;
  color: #333;
}

.teacher-btn {
  background-color: #fff3e0;
  color: #ff6b00;
}

.quick-btn:active {
  opacity: 0.8;
}

.quick-login-tip {
  font-size: 22rpx;
  color: #999;
  text-align: center;
  margin-top: 16rpx;
}

.footer {
  margin-top: 40rpx;
  font-size: 24rpx;
  color: #ccc;
  text-align: center;
}
