.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 40rpx;
  background-color: #fff;
}

.login-box {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 40rpx;
  background-color: #FF6B00;
  border-radius: 50%;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #333;
}

.subtitle {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
}

/* 重试提示 */
.retry-tip {
  width: 100%;
  background-color: #FFF3E0;
  border-left: 4rpx solid #FF6B00;
  padding: 20rpx;
  margin-bottom: 40rpx;
  border-radius: 8rpx;
}

.retry-text {
  font-size: 26rpx;
  color: #FF6B00;
}

/* 主登录按钮 */
.login-btn {
  width: 100%;
  background-color: #07c160;
  color: #fff;
  border-radius: 50rpx;
  padding: 20rpx 0;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.login-btn:active {
  opacity: 0.9;
}

/* 测试登录按钮 */
.test-btn {
  width: 100%;
  background-color: #fff;
  color: #07c160;
  border: 2rpx solid #07c160;
  border-radius: 50rpx;
  padding: 18rpx 0;
  font-size: 28rpx;
}

.test-btn:active {
  opacity: 0.8;
  background-color: #f0f9ff;
}

.footer {
  margin-top: 40rpx;
  font-size: 24rpx;
  color: #ccc;
  text-align: center;
}
