/* pages/radar/radar.wxss */
page {
  background-color: #0f172a; /* Slate 900 */
  height: 100vh;
  overflow: hidden;
  width: 100%;
}

.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  width: 100%;
  overflow: hidden;
}

.radar-header {
  position: absolute;
  top: 100rpx;
  left: 60rpx;
  z-index: 10;
}

.radar-title {
  font-size: 60rpx;
  font-weight: 900;
  color: #fff;
  font-style: italic;
  letter-spacing: -2rpx;
  display: block;
}

.radar-subtitle {
  color: var(--primary-color);
  font-family: monospace;
  font-size: 24rpx;
  letter-spacing: 4rpx;
  animation: blink 2s infinite;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

.radar-circle-wrapper {
  width: 600rpx;
  height: 600rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: -80rpx;
}

.ripple {
  position: absolute;
  border: 1px solid rgba(56, 189, 248, 0.3);
  border-radius: 50%;
  animation: ripple 3s linear infinite;
}

.ripple-1 { width: 200rpx; height: 200rpx; animation-delay: 0s; }
.ripple-2 { width: 200rpx; height: 200rpx; animation-delay: 1s; }
.ripple-3 { width: 200rpx; height: 200rpx; animation-delay: 2s; }

@keyframes ripple {
  0% {
    width: 200rpx;
    height: 200rpx;
    opacity: 0.8;
    border-width: 4rpx;
  }
  100% {
    width: 800rpx;
    height: 800rpx;
    opacity: 0;
    border-width: 0;
  }
}

.user-dot {
  width: 32rpx;
  height: 32rpx;
  background-color: var(--primary-color);
  border-radius: 50%;
  position: relative;
  z-index: 5;
  box-shadow: 0 0 40rpx var(--primary-color);
}

.user-dot-pulse {
  position: absolute;
  top: -10rpx;
  left: -10rpx;
  right: -10rpx;
  bottom: -10rpx;
  background-color: rgba(56, 189, 248, 0.4);
  border-radius: 50%;
  animation: pulse 1.5s infinite;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); opacity: 0.6; }
  50% { transform: scale(1.5); opacity: 0.2; }
}

.scan-line {
  position: absolute;
  width: 300rpx;
  height: 4rpx;
  background: linear-gradient(to right, transparent, var(--primary-color));
  top: 50%;
  left: 50%;
  transform-origin: 0 0;
  animation: scan 4s linear infinite;
  opacity: 0.5;
}

@keyframes scan {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* Stall Points - 动态定位 */
.stall-point {
  position: absolute;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: bounce 3s infinite ease-in-out;
  z-index: 20;
}

.stall-point:nth-child(4) { animation-duration: 3s; }
.stall-point:nth-child(5) { animation-duration: 4s; }
.stall-point:nth-child(6) { animation-duration: 3.5s; }
.stall-point:nth-child(7) { animation-duration: 2.8s; }
.stall-point:nth-child(8) { animation-duration: 3.2s; }
.stall-point:nth-child(9) { animation-duration: 3.8s; }

@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-20rpx); }
}

.stall-icon {
  width: 80rpx;
  height: 80rpx;
  background: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  box-shadow: 0 0 20rpx rgba(255,255,255,0.5);
  border: 4rpx solid var(--accent-color);
  overflow: hidden;
}

.stall-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.stall-label {
  margin-top: 8rpx;
  background: rgba(0,0,0,0.7);
  color: #fff;
  padding: 6rpx 14rpx;
  border-radius: 12rpx;
  backdrop-filter: blur(4rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}

.stall-name {
  font-size: 20rpx;
  font-weight: 600;
  white-space: nowrap;
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
}

.stall-distance {
  font-size: 18rpx;
  color: #0ea5e9;
  font-weight: 500;
}

/* ============================================
   附近商家列表
   ============================================ */
.nearby-section {
  position: absolute;
  bottom: 140rpx;
  left: 0;
  right: 0;
  padding: 0 24rpx;
}

.nearby-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 0 8rpx;
}

.nearby-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
}

.nearby-count {
  font-size: 22rpx;
  color: #64748b;
}

.nearby-list {
  white-space: nowrap;
  width: 100%;
}

.nearby-item {
  display: inline-flex;
  flex-direction: column;
  width: 180rpx;
  margin-right: 20rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
  overflow: hidden;
  backdrop-filter: blur(10rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.nearby-img {
  width: 100%;
  height: 120rpx;
  background: #1e293b;
}

.nearby-info {
  padding: 12rpx;
}

.nearby-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #fff;
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-bottom: 6rpx;
}

.nearby-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.nearby-rating {
  font-size: 20rpx;
  color: #fbbf24;
}

.nearby-distance {
  font-size: 18rpx;
  color: #0ea5e9;
  font-weight: 500;
}

.nearby-item-spacer {
  display: inline-block;
  width: 24rpx;
}

.radar-footer {
  position: absolute;
  bottom: 80rpx;
  color: var(--text-grey);
  font-size: 24rpx;
}

/* ============================================
   Popup Styles
   ============================================ */
.stall-popup-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.6);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
}

.stall-popup-mask.show {
  opacity: 1;
  pointer-events: auto;
}

.stall-popup {
  width: 600rpx;
  background: #fff;
  border-radius: 32rpx;
  overflow: hidden;
  transform: scale(0.9);
  transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.stall-popup-mask.show .stall-popup {
  transform: scale(1);
}

.popup-header {
  height: 300rpx;
  position: relative;
}

.popup-img {
  width: 100%;
  height: 100%;
  background: #f3f4f6;
}

.popup-close {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 60rpx;
  height: 60rpx;
  background: rgba(0,0,0,0.3);
  border-radius: 50%;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  backdrop-filter: blur(4px);
}

.popup-distance-badge {
  position: absolute;
  bottom: 20rpx;
  left: 20rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  backdrop-filter: blur(4px);
}

.distance-icon {
  font-size: 22rpx;
}

.popup-content {
  padding: 30rpx;
}

.popup-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.popup-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #1e293b;
}

.popup-rating {
  font-size: 28rpx;
  font-weight: 700;
  color: #f59e0b;
}

.popup-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.popup-tag {
  font-size: 22rpx;
  color: #64748b;
  background: #f1f5f9;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
}

.popup-stats {
  display: flex;
  justify-content: space-around;
  padding: 20rpx 0;
  margin-bottom: 16rpx;
  background: #f8fafc;
  border-radius: 12rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.stat-num {
  font-size: 32rpx;
  font-weight: 800;
  color: #1e293b;
}

.stat-label {
  font-size: 22rpx;
  color: #94a3b8;
}

.popup-desc {
  font-size: 26rpx;
  color: #64748b;
  line-height: 1.6;
  display: block;
  margin-bottom: 30rpx;
}

.popup-btn {
  background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
  color: #fff;
  border-radius: 100rpx;
  font-weight: 700;
  font-size: 30rpx;
  border: none;
}
