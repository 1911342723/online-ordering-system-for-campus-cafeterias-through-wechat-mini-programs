/* pages/community/publish.wxss */
page {
  background: #f1f5f9;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

.container {
  padding: 24rpx;
  box-sizing: border-box;
  width: 100%;
  overflow-x: hidden;
}

/* 图片上传区域 */
.image-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.preview-img {
  width: 100%;
  height: 100%;
}

.delete-btn {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 24rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-image {
  width: 200rpx;
  height: 200rpx;
  background: #f8fafc;
  border-radius: 12rpx;
  border: 2rpx dashed #cbd5e1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.add-icon {
  font-size: 48rpx;
}

.add-text {
  font-size: 24rpx;
  color: #64748b;
}

.add-hint {
  font-size: 20rpx;
  color: #94a3b8;
}

/* 标题输入 */
.input-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  position: relative;
  box-sizing: border-box;
}

.title-input {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
  width: 100%;
  box-sizing: border-box;
}

.char-count {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  font-size: 22rpx;
  color: #94a3b8;
}

/* 内容输入 */
.content-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  position: relative;
  min-height: 240rpx;
  box-sizing: border-box;
}

.content-input {
  width: 100%;
  min-height: 180rpx;
  font-size: 28rpx;
  color: #334155;
  line-height: 1.6;
  box-sizing: border-box;
}

/* ============================================
   关联订单区域
   ============================================ */
.order-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.section-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
}

.required-tag {
  font-size: 20rpx;
  color: #fff;
  background: #ef4444;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.section-hint {
  font-size: 22rpx;
  color: #94a3b8;
}

.order-select {
  background: #f8fafc;
  border-radius: 12rpx;
  border: 2rpx solid #e2e8f0;
  overflow: hidden;
}

.order-info {
  padding: 20rpx;
}

.order-merchant {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.merchant-logo {
  width: 64rpx;
  height: 64rpx;
  border-radius: 12rpx;
  background: #e2e8f0;
  flex-shrink: 0;
}

.merchant-detail {
  flex: 1;
  min-width: 0;
}

.merchant-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
  display: block;
  margin-bottom: 4rpx;
}

.order-no {
  font-size: 22rpx;
  color: #64748b;
}

.order-items {
  padding: 12rpx 16rpx;
  background: #fff;
  border-radius: 8rpx;
  margin-bottom: 12rpx;
}

.item-text {
  font-size: 24rpx;
  color: #475569;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.change-btn {
  font-size: 26rpx;
  color: #0ea5e9;
  font-weight: 600;
  text-align: right;
}

.order-placeholder {
  display: flex;
  align-items: center;
  padding: 28rpx 20rpx;
  gap: 16rpx;
}

.placeholder-icon {
  font-size: 40rpx;
}

.placeholder-text {
  flex: 1;
  font-size: 28rpx;
  color: #94a3b8;
}

.placeholder-arrow {
  font-size: 32rpx;
  color: #94a3b8;
}

.order-hint, .rating-hint {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  padding: 16rpx;
  background: #fef3c7;
  border-radius: 8rpx;
  margin-top: 16rpx;
}

.hint-icon {
  font-size: 24rpx;
  flex-shrink: 0;
}

.hint-text {
  font-size: 22rpx;
  color: #92400e;
  line-height: 1.4;
}

/* ============================================
   评价类型选择
   ============================================ */
.rating-type-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.rating-options {
  display: flex;
  gap: 16rpx;
}

.rating-option {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  border: 2rpx solid #e2e8f0;
  background: #f8fafc;
  transition: all 0.2s;
  position: relative;
  min-width: 0;
}

.rating-option.positive.active {
  border-color: #22c55e;
  background: linear-gradient(135deg, #f0fdf4, #dcfce7);
}

.rating-option.negative.active {
  border-color: #ef4444;
  background: linear-gradient(135deg, #fef2f2, #fee2e2);
}

.option-icon {
  font-size: 40rpx;
  flex-shrink: 0;
}

.option-content {
  flex: 1;
  min-width: 0;
}

.option-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1e293b;
  display: block;
  margin-bottom: 4rpx;
}

.rating-option.positive.active .option-title {
  color: #16a34a;
}

.rating-option.negative.active .option-title {
  color: #dc2626;
}

.option-desc {
  font-size: 20rpx;
  color: #64748b;
}

.option-check {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #fff;
  font-weight: 700;
  flex-shrink: 0;
}

.rating-option.positive.active .option-check {
  background: #22c55e;
}

.rating-option.negative.active .option-check {
  background: #ef4444;
}

/* 标签区域 */
.tags-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.tags-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.tag-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background: #e0f2fe;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #0284c7;
  flex-shrink: 0;
}

.tag-delete {
  font-size: 20rpx;
  color: #0284c7;
}

.add-tag {
  padding: 12rpx 20rpx;
  background: #f1f5f9;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #64748b;
  border: 2rpx dashed #cbd5e1;
  flex-shrink: 0;
}

.recommend-tags {
  border-top: 1rpx solid #e2e8f0;
  padding-top: 20rpx;
}

.recommend-title {
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 16rpx;
  display: block;
}

.recommend-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.recommend-item {
  padding: 10rpx 18rpx;
  background: #f8fafc;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #64748b;
  border: 1rpx solid #e2e8f0;
  transition: all 0.2s;
  flex-shrink: 0;
}

.recommend-item.selected {
  background: #e0f2fe;
  color: #0284c7;
  border-color: #0ea5e9;
}

/* 底部按钮 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.draft-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f1f5f9;
  border-radius: 44rpx;
  font-size: 30rpx;
  color: #64748b;
  font-weight: 600;
}

.publish-btn {
  flex: 2;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #cbd5e1;
  border-radius: 44rpx;
  font-size: 30rpx;
  color: #fff;
  font-weight: 700;
  transition: all 0.2s;
}

.publish-btn.active {
  background: linear-gradient(135deg, #0ea5e9, #0284c7);
  box-shadow: 0 8rpx 20rpx rgba(14, 165, 233, 0.3);
}

/* ============================================
   标签输入弹窗
   ============================================ */
.tag-modal, .order-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: none;
}

.tag-modal.show, .order-modal.show {
  display: block;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
}

.modal-close {
  font-size: 36rpx;
  color: #94a3b8;
  padding: 10rpx;
}

.tag-input {
  width: 100%;
  height: 88rpx;
  background: #f1f5f9;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.modal-footer {
  display: flex;
  justify-content: flex-end;
}

.confirm-btn {
  padding: 20rpx 48rpx;
  background: linear-gradient(135deg, #0ea5e9, #0284c7);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 40rpx;
}

/* ============================================
   订单选择弹窗
   ============================================ */
.order-modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 75vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  flex-direction: column;
  animation: slideUp 0.3s ease;
}

.order-modal-content .modal-header {
  padding: 32rpx;
  border-bottom: 1rpx solid #f1f5f9;
  margin-bottom: 0;
}

.order-list {
  flex: 1;
  padding: 24rpx;
  padding-bottom: env(safe-area-inset-bottom);
}

.order-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
  gap: 16rpx;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #64748b;
}

.empty-hint {
  font-size: 24rpx;
  color: #94a3b8;
}

.order-item {
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.order-item.selected {
  border-color: #0ea5e9;
  background: #e0f2fe;
}

.order-item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.order-merchant-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}

.order-merchant-logo {
  width: 56rpx;
  height: 56rpx;
  border-radius: 10rpx;
  background: #e2e8f0;
  flex-shrink: 0;
}

.order-merchant-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-time {
  font-size: 22rpx;
  color: #94a3b8;
  flex-shrink: 0;
}

.order-item-dishes {
  font-size: 24rpx;
  color: #64748b;
  padding: 12rpx 0;
  border-top: 1rpx solid #e2e8f0;
  border-bottom: 1rpx solid #e2e8f0;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-item-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.order-amount {
  font-size: 28rpx;
  font-weight: 700;
  color: #1e293b;
}

.order-check {
  width: 44rpx;
  height: 44rpx;
  background: #0ea5e9;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
}

.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 32rpx 0;
  color: #64748b;
  font-size: 26rpx;
}

.loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid #e2e8f0;
  border-top-color: #0ea5e9;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
