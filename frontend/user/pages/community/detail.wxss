/* pages/community/detail.wxss */
page {
  background: #fff;
  height: 100vh;
  overflow: hidden;
}

.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

/* 可滚动内容区域 */
.content-scroll {
  flex: 1;
  height: 0; /* 关键：让 flex: 1 生效 */
  box-sizing: border-box;
}

/* 图片轮播 */
.image-swiper {
  height: 750rpx;
  background: #f5f5f5;
}

.swiper-img {
  width: 100%;
  height: 100%;
}

/* 作者信息 */
.author-section {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  gap: 20rpx;
}

.author-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #f5f5f5;
  border: 2rpx solid #fff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.author-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.author-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1e293b;
}

.author-time {
  font-size: 24rpx;
  color: #94a3b8;
}

.follow-btn {
  padding: 12rpx 32rpx;
  background: linear-gradient(135deg, #0ea5e9, #0284c7);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(14, 165, 233, 0.3);
}

/* 内容区域 */
.content-section {
  padding: 20rpx 30rpx 30rpx;
}

.note-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #0f172a;
  margin-bottom: 24rpx;
  line-height: 1.4;
}

.note-desc {
  font-size: 30rpx;
  color: #334155;
  line-height: 1.8;
  white-space: pre-wrap;
  margin-bottom: 24rpx;
}

.note-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag {
  color: #0ea5e9;
  font-size: 28rpx;
  font-weight: 500;
}

/* 分割线 */
.divider {
  height: 16rpx;
  background: #f1f5f9;
}

/* 评论区域 */
.comment-section {
  padding: 30rpx;
}

.comment-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 30rpx;
}

.comment-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
}

.comment-count {
  font-size: 28rpx;
  color: #64748b;
}

/* 空评论状态 */
.empty-comments {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
  gap: 20rpx;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #94a3b8;
}

/* 评论列表 */
.comment-list {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.comment-item {
  display: flex;
  gap: 20rpx;
}

.comment-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #f5f5f5;
  flex-shrink: 0;
}

.comment-content-box {
  flex: 1;
  min-width: 0;
}

.comment-user {
  font-size: 26rpx;
  color: #64748b;
  margin-bottom: 8rpx;
  font-weight: 600;
}

.comment-text {
  font-size: 28rpx;
  color: #1e293b;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.comment-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.comment-time {
  font-size: 24rpx;
  color: #94a3b8;
}

.comment-actions {
  display: flex;
  gap: 24rpx;
}

.action-btn {
  font-size: 24rpx;
  color: #64748b;
}

/* 回复列表 */
.reply-list {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: #f8fafc;
  border-radius: 12rpx;
}

.reply-item {
  font-size: 26rpx;
  color: #475569;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.reply-item:last-child {
  margin-bottom: 0;
}

.reply-user {
  color: #0ea5e9;
  font-weight: 600;
}

/* 底部占位 - 为固定底部栏留出空间 */
.footer-spacer {
  height: calc(140rpx + env(safe-area-inset-bottom));
}

/* ============================================
   固定底部操作栏
   ============================================ */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1px solid #f1f5f9;
  display: flex;
  align-items: center;
  gap: 24rpx;
  z-index: 100;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.input-box {
  flex: 1;
  background: #f1f5f9;
  height: 72rpx;
  border-radius: 36rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.input-icon {
  font-size: 28rpx;
}

.placeholder {
  font-size: 28rpx;
  color: #94a3b8;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.action-icons {
  display: flex;
  gap: 32rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  min-width: 56rpx;
}

.action-item.active .count {
  color: #0ea5e9;
}

.icon {
  font-size: 44rpx;
  line-height: 1;
}

.count {
  font-size: 22rpx;
  color: #64748b;
  font-weight: 600;
}

/* ============================================
   评论输入弹窗
   ============================================ */
.comment-modal {
  position: fixed;
  inset: 0;
  z-index: 200;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s;
}

.comment-modal.show {
  opacity: 1;
  visibility: visible;
}

.modal-mask {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.comment-modal.show .modal-content {
  transform: translateY(0);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
}

.modal-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #64748b;
  background: #f1f5f9;
  border-radius: 50%;
}

.comment-textarea {
  width: 100%;
  min-height: 200rpx;
  max-height: 400rpx;
  padding: 24rpx;
  background: #f8fafc;
  border-radius: 16rpx;
  font-size: 30rpx;
  color: #1e293b;
  line-height: 1.6;
  box-sizing: border-box;
}

.modal-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 24rpx;
}

.char-count {
  font-size: 24rpx;
  color: #94a3b8;
}

.send-btn {
  padding: 16rpx 48rpx;
  background: #e2e8f0;
  color: #94a3b8;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 32rpx;
  border: none;
  transition: all 0.2s;
}

.send-btn.active {
  background: linear-gradient(135deg, #0ea5e9, #0284c7);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(14, 165, 233, 0.3);
}

.send-btn[disabled] {
  opacity: 0.6;
}
