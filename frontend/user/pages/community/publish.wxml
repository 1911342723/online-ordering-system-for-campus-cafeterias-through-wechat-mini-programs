<!--pages/community/publish.wxml-->
<view class="container">
  <!-- 图片上传区域 -->
  <view class="image-section">
    <view class="image-list">
      <view class="image-item" wx:for="{{images}}" wx:key="*this">
        <image src="{{item}}" mode="aspectFill" class="preview-img"></image>
        <view class="delete-btn" catchtap="deleteImage" data-index="{{index}}">✕</view>
      </view>
      <view class="add-image" bindtap="chooseImage" wx:if="{{images.length < 9}}">
        <text class="add-icon">📷</text>
        <text class="add-text">添加图片</text>
        <text class="add-hint">{{images.length}}/9</text>
      </view>
    </view>
  </view>

  <!-- 标题输入 -->
  <view class="input-section">
    <input 
      class="title-input" 
      placeholder="添加标题，让更多人看到你" 
      value="{{title}}"
      bindinput="onTitleInput"
      maxlength="50"
    />
    <text class="char-count">{{title.length}}/50</text>
  </view>

  <!-- 内容输入 -->
  <view class="content-section">
    <textarea 
      class="content-input" 
      placeholder="分享你的美食故事..."
      value="{{content}}"
      bindinput="onContentInput"
      maxlength="1000"
      auto-height
    ></textarea>
    <text class="char-count">{{content.length}}/1000</text>
  </view>

  <!-- 关联订单（必选） -->
  <view class="order-section">
    <view class="section-header">
      <text class="section-title">关联订单</text>
      <text class="required-tag">必选</text>
    </view>
    <view class="order-select" bindtap="selectOrder">
      <view class="order-info" wx:if="{{linkedOrder}}">
        <view class="order-merchant">
          <image class="merchant-logo" src="{{linkedOrder.merchantImage || defaultMerchantImg}}" mode="aspectFill"></image>
          <view class="merchant-detail">
            <text class="merchant-name">{{linkedOrder.merchantName}}</text>
            <text class="order-no">订单号: {{linkedOrder.orderNo}}</text>
          </view>
        </view>
        <view class="order-items">
          <text class="item-text">{{linkedOrder.dishNames}}</text>
        </view>
        <text class="change-btn">更换</text>
      </view>
      <view class="order-placeholder" wx:else>
        <text class="placeholder-icon">📋</text>
        <text class="placeholder-text">选择已完成的订单</text>
        <text class="placeholder-arrow">›</text>
      </view>
    </view>
    <view class="order-hint">
      <text class="hint-icon">💡</text>
      <text class="hint-text">关联订单可防止恶意刷分，让评价更真实可信</text>
    </view>
  </view>

  <!-- 评价类型（好评/吐槽） -->
  <view class="rating-type-section">
    <view class="section-header">
      <text class="section-title">评价类型</text>
      <text class="required-tag">必选</text>
    </view>
    <view class="rating-options">
      <view 
        class="rating-option positive {{ratingType === 'positive' ? 'active' : ''}}" 
        bindtap="selectRatingType" 
        data-type="positive"
      >
        <view class="option-icon">👍</view>
        <view class="option-content">
          <text class="option-title">好评推荐</text>
          <text class="option-desc">推荐给其他同学</text>
        </view>
        <view class="option-check" wx:if="{{ratingType === 'positive'}}">✓</view>
      </view>
      <view 
        class="rating-option negative {{ratingType === 'negative' ? 'active' : ''}}" 
        bindtap="selectRatingType" 
        data-type="negative"
      >
        <view class="option-icon">👎</view>
        <view class="option-content">
          <text class="option-title">吐槽避雷</text>
          <text class="option-desc">提醒同学注意</text>
        </view>
        <view class="option-check" wx:if="{{ratingType === 'negative'}}">✓</view>
      </view>
    </view>
    <view class="rating-hint">
      <text class="hint-icon">📊</text>
      <text class="hint-text">你的评价将计入商家红黑榜，帮助更多同学做选择</text>
    </view>
  </view>

  <!-- 添加标签 -->
  <view class="tags-section">
    <view class="section-header">
      <text class="section-title">添加标签</text>
      <text class="section-hint">最多添加5个</text>
    </view>
    <view class="tags-list">
      <view class="tag-item" wx:for="{{tags}}" wx:key="*this">
        <text># {{item}}</text>
        <text class="tag-delete" catchtap="deleteTag" data-index="{{index}}">✕</text>
      </view>
      <view class="add-tag" bindtap="showTagInput" wx:if="{{tags.length < 5}}">
        <text>+ 添加标签</text>
      </view>
    </view>
    
    <!-- 推荐标签 -->
    <view class="recommend-tags">
      <text class="recommend-title">推荐标签</text>
      <view class="recommend-list">
        <view 
          class="recommend-item {{tags.includes(item) ? 'selected' : ''}}" 
          wx:for="{{recommendTags}}" 
          wx:key="*this"
          bindtap="addRecommendTag"
          data-tag="{{item}}"
        >
          # {{item}}
        </view>
      </view>
    </view>
  </view>
</view>

<!-- 底部发布按钮 -->
<view class="footer">
  <view class="draft-btn" bindtap="saveDraft">存草稿</view>
  <view class="publish-btn {{canPublish ? 'active' : ''}}" bindtap="publish">发布</view>
</view>

<!-- 标签输入弹窗 -->
<view class="tag-modal {{showTagModal ? 'show' : ''}}" catchtouchmove="preventMove">
  <view class="modal-mask" bindtap="hideTagInput"></view>
  <view class="modal-content">
    <view class="modal-header">
      <text class="modal-title">添加标签</text>
      <text class="modal-close" bindtap="hideTagInput">✕</text>
    </view>
    <input 
      class="tag-input" 
      placeholder="输入标签名称"
      value="{{newTag}}"
      bindinput="onTagInput"
      bindconfirm="confirmAddTag"
      focus="{{showTagModal}}"
      maxlength="20"
    />
    <view class="modal-footer">
      <button class="confirm-btn" bindtap="confirmAddTag">确定</button>
    </view>
  </view>
</view>

<!-- 订单选择弹窗 -->
<view class="order-modal {{showOrderModal ? 'show' : ''}}" catchtouchmove="preventMove">
  <view class="modal-mask" bindtap="hideOrderModal"></view>
  <view class="order-modal-content">
    <view class="modal-header">
      <text class="modal-title">选择订单</text>
      <text class="modal-close" bindtap="hideOrderModal">✕</text>
    </view>
    
    <!-- 订单列表 -->
    <scroll-view scroll-y class="order-list" bindscrolltolower="loadMoreOrders">
      <view class="order-empty" wx:if="{{orderList.length === 0 && !orderLoading}}">
        <text class="empty-icon">📋</text>
        <text class="empty-text">暂无已完成的订单</text>
        <text class="empty-hint">完成订单后才能发布评价哦</text>
      </view>
      
      <view 
        class="order-item {{linkedOrder && linkedOrder.id === item.id ? 'selected' : ''}}" 
        wx:for="{{orderList}}" 
        wx:key="id"
        bindtap="onSelectOrder"
        data-order="{{item}}"
      >
        <view class="order-item-header">
          <view class="order-merchant-info">
            <image class="order-merchant-logo" src="{{item.merchantImage || defaultMerchantImg}}" mode="aspectFill"></image>
            <text class="order-merchant-name">{{item.merchantName}}</text>
          </view>
          <text class="order-time">{{item.orderTimeStr}}</text>
        </view>
        <view class="order-item-dishes">
          <text>{{item.dishNames}}</text>
        </view>
        <view class="order-item-footer">
          <text class="order-amount">¥{{item.amount}}</text>
          <view class="order-check" wx:if="{{linkedOrder && linkedOrder.id === item.id}}">✓</view>
        </view>
      </view>
      
      <view class="loading-more" wx:if="{{orderLoading}}">
        <view class="loading-spinner"></view>
        <text>加载中...</text>
      </view>
    </scroll-view>
  </view>
</view>
