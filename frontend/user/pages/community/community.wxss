/* pages/community/community.wxss */
page {
  background-color: #f1f5f9;
  height: 100vh;
}

.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

/* ============================================
   搜索栏 - 单独一行
   ============================================ */
.search-header {
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, #0ea5e9, #0284c7);
}

.search-bar {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 40rpx;
  padding: 20rpx 28rpx;
  gap: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.search-icon {
  font-size: 32rpx;
}

.search-placeholder {
  font-size: 28rpx;
  color: #94a3b8;
}

/* ============================================
   Tab 栏 - 均匀分布
   ============================================ */
.tabs-wrapper {
  background: #fff;
  padding: 0 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.tabs {
  display: flex;
  justify-content: space-around;
  align-items: center;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 0;
  position: relative;
  transition: all 0.2s;
}

.tab-text {
  font-size: 30rpx;
  color: #64748b;
  font-weight: 500;
  transition: all 0.2s;
}

.tab-item.active .tab-text {
  color: #0ea5e9;
  font-size: 32rpx;
  font-weight: 700;
}

.tab-indicator {
  position: absolute;
  bottom: 8rpx;
  width: 48rpx;
  height: 6rpx;
  background: linear-gradient(90deg, #0ea5e9, #38bdf8);
  border-radius: 3rpx;
}

/* ============================================
   内容滚动区域
   ============================================ */
.content-scroll {
  flex: 1;
  height: 0;
}

.tab-content {
  min-height: 100%;
}

/* ============================================
   空关注状态
   ============================================ */
.empty-follow {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
  text-align: center;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #64748b;
  margin-bottom: 40rpx;
  line-height: 1.5;
}

.empty-btn {
  padding: 20rpx 60rpx;
  background: linear-gradient(135deg, #0ea5e9, #0284c7);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 40rpx;
  box-shadow: 0 8rpx 20rpx rgba(14, 165, 233, 0.3);
}

/* ============================================
   热门话题
   ============================================ */
.hot-topics {
  padding: 20rpx 0;
  background: #fff;
  margin-bottom: 16rpx;
}

.topics-scroll {
  white-space: nowrap;
  padding: 0 24rpx;
}

.topic-item {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: #fef3c7;
  border-radius: 24rpx;
  margin-right: 16rpx;
}

.topic-icon {
  font-size: 24rpx;
}

.topic-name {
  font-size: 26rpx;
  color: #b45309;
  font-weight: 600;
}

/* ============================================
   位置栏
   ============================================ */
.location-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 24rpx;
  background: #fff;
  margin-bottom: 16rpx;
}

.location-icon {
  font-size: 28rpx;
}

.location-text {
  flex: 1;
  font-size: 28rpx;
  color: #1e293b;
  font-weight: 600;
}

.location-change {
  font-size: 26rpx;
  color: #0ea5e9;
  font-weight: 600;
}

/* ============================================
   瀑布流布局
   ============================================ */
.waterfall-content {
  padding: 16rpx;
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
}

.column {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* ============================================
   笔记卡片
   ============================================ */
.note-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  position: relative;
  transition: transform 0.2s;
}

.note-card:active {
  transform: scale(0.98);
}

.card-badge {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  background: linear-gradient(135deg, #f59e0b, #fbbf24);
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  z-index: 1;
}

.distance-badge {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  z-index: 1;
}

.note-img {
  width: 100%;
  display: block;
  background: #f1f5f9;
  min-height: 200rpx;
}

.note-info {
  padding: 20rpx;
}

.note-title {
  font-size: 28rpx;
  color: #1e293b;
  font-weight: 600;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.note-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.user-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}

.user-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #e2e8f0;
  flex-shrink: 0;
}

.user-name {
  font-size: 22rpx;
  color: #64748b;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.like-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.heart-icon {
  font-size: 28rpx;
  line-height: 1;
}

.like-num {
  font-size: 24rpx;
  color: #64748b;
  font-weight: 500;
}

/* ============================================
   加载状态
   ============================================ */
.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 40rpx 0;
  color: #64748b;
  font-size: 26rpx;
}

.loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid #e2e8f0;
  border-top-color: #0ea5e9;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.no-more {
  text-align: center;
  padding: 40rpx 0;
  color: #94a3b8;
  font-size: 24rpx;
}

.bottom-spacer {
  height: 160rpx;
}

/* ============================================
   发布按钮
   ============================================ */
.publish-btn {
  position: fixed;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  right: 32rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 24rpx 36rpx;
  background: linear-gradient(135deg, #0ea5e9, #0284c7);
  border-radius: 50rpx;
  box-shadow: 0 8rpx 24rpx rgba(14, 165, 233, 0.4);
  z-index: 99;
  transition: all 0.2s;
}

.publish-btn:active {
  transform: scale(0.95);
}

.publish-icon {
  font-size: 32rpx;
}

.publish-text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 700;
}
