<!-- 支付页面 -->
<view class="container">
  <!-- 订单信息 -->
  <view class="order-section">
    <view class="section-title">订单信息</view>
    <view class="order-info">
      <view class="info-item">
        <text class="label">订单号</text>
        <text class="value">{{orderInfo.number}}</text>
      </view>
      <view class="info-item">
        <text class="label">订单金额</text>
        <text class="amount">¥{{orderInfo.amount}}</text>
      </view>
    </view>
  </view>

  <!-- 支付方式选择 -->
  <view class="payment-section">
    <view class="section-title">选择支付方式</view>
    
    <!-- 钱包余额支付 -->
    <view class="payment-item {{paymentMethod === 'balance' ? 'active' : ''}}" bindtap="selectPayment" data-method="balance">
      <view class="payment-left">
        <view class="payment-icon">💰</view>
        <view class="payment-info">
          <text class="payment-name">钱包余额</text>
          <text class="payment-desc">当前余额：¥{{userBalance}}</text>
        </view>
      </view>
      <view class="payment-check"></view>
    </view>

    <!-- 微信支付 -->
    <view class="payment-item {{paymentMethod === 'wechat' ? 'active' : ''}}" bindtap="selectPayment" data-method="wechat">
      <view class="payment-left">
        <view class="payment-icon">💚</view>
        <view class="payment-info">
          <text class="payment-name">微信支付</text>
          <text class="payment-desc">安全快捷的支付方式</text>
        </view>
      </view>
      <view class="payment-check"></view>
    </view>

    <!-- 支付宝支付 -->
    <view class="payment-item {{paymentMethod === 'alipay' ? 'active' : ''}}" bindtap="selectPayment" data-method="alipay">
      <view class="payment-left">
        <view class="payment-icon">💙</view>
        <view class="payment-info">
          <text class="payment-name">支付宝支付</text>
          <text class="payment-desc">便捷支付，值得信赖</text>
        </view>
      </view>
      <view class="payment-check"></view>
    </view>
  </view>

  <!-- 余额不足提示 -->
  <view class="tip-section" wx:if="{{paymentMethod === 'balance' && insufficientBalance}}">
    <view class="tip-box">
      <text class="tip-icon">⚠️</text>
      <text class="tip-text">余额不足，请先充值或选择其他支付方式</text>
    </view>
    <button class="recharge-btn" bindtap="goRecharge">去充值</button>
  </view>
</view>

<!-- 底部支付按钮 -->
<view class="footer">
  <view class="total-info">
    <text class="label">需支付：</text>
    <text class="price">¥{{orderInfo.amount}}</text>
  </view>
  <button class="pay-btn" bindtap="submitPayment">立即支付</button>
</view>

