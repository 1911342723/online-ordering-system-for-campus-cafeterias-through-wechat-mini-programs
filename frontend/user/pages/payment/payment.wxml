<!--pages/payment/payment.wxml-->
<view class="container">
  <!-- 支付金额 -->
  <view class="amount-section">
    <view class="amount-label">支付金额</view>
    <view class="amount-value">¥{{orderAmount}}</view>
  </view>

  <!-- 支付方式 -->
  <view class="pay-method-section">
    <view class="section-title">选择支付方式</view>
    
    <view 
      wx:for="{{payMethods}}" 
      wx:key="id"
      class="pay-method-item {{payMethod === item.id ? 'active' : ''}}"
      bindtap="selectPayMethod"
      data-method="{{item.id}}"
    >
      <view class="pay-left">
        <image class="pay-icon" src="{{item.icon}}" mode="aspectFit"></image>
        <view class="pay-info">
          <view class="pay-name">{{item.name}}</view>
          <view class="pay-desc" wx:if="{{item.desc}}">{{item.desc}}</view>
        </view>
      </view>
      <view class="radio {{payMethod === item.id ? 'checked' : ''}}">
        <view class="radio-inner"></view>
      </view>
    </view>
  </view>

  <!-- 支付说明 -->
  <view class="tips-section">
    <view class="tips-title">支付说明</view>
    <view class="tips-text">1. 支付成功后商家将开始制作您的订单</view>
    <view class="tips-text">2. 如需退款请在订单详情页申请</view>
    <view class="tips-text">3. 本次支付为模拟支付，实际不会扣费</view>
  </view>

  <!-- 底部支付按钮 -->
  <view class="footer">
    <view class="footer-amount">
      <text class="label">实付款：</text>
      <text class="value">¥{{orderAmount}}</text>
    </view>
    <button class="pay-btn" bindtap="confirmPay">
      确认支付
    </button>
  </view>
</view>

