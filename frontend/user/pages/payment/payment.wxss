/* pages/payment/payment.wxss */
.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 160rpx;
}

/* 支付金额区域 */
.amount-section {
  background: linear-gradient(135deg, #FF6B35, #FF8F3D);
  padding: 80rpx 40rpx;
  text-align: center;
  color: #fff;
}

.amount-label {
  font-size: 28rpx;
  opacity: 0.9;
  margin-bottom: 20rpx;
}

.amount-value {
  font-size: 80rpx;
  font-weight: bold;
}

/* 支付方式 */
.pay-method-section {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 30rpx;
}

.pay-method-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 20rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid #f0f0f0;
  transition: all 0.3s ease;
}

.pay-method-item:last-child {
  margin-bottom: 0;
}

.pay-method-item.active {
  border-color: #FF6B35;
  background: rgba(255, 107, 53, 0.05);
}

.pay-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.pay-icon {
  width: 60rpx;
  height: 60rpx;
  flex-shrink: 0;
}

.pay-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.pay-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.pay-desc {
  font-size: 24rpx;
  color: #999;
}

.radio {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #ddd;
  display: flex;
  align-items: center;
  justify-content: center;
}

.radio.checked {
  border-color: #FF6B35;
}

.radio-inner {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: transparent;
}

.radio.checked .radio-inner {
  background: #FF6B35;
}

/* 支付说明 */
.tips-section {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
}

.tips-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.tips-text {
  font-size: 24rpx;
  color: #999;
  line-height: 2;
  padding-left: 20rpx;
}

/* 底部支付按钮 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 30rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.footer-amount {
  display: flex;
  align-items: baseline;
}

.footer-amount .label {
  font-size: 26rpx;
  color: #666;
}

.footer-amount .value {
  font-size: 40rpx;
  font-weight: bold;
  color: #FF6B35;
  margin-left: 10rpx;
}

.pay-btn {
  flex-shrink: 0;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 60rpx;
  background: linear-gradient(135deg, #FF6B35, #FF8F3D);
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
}

.pay-btn::after {
  border: none;
}

