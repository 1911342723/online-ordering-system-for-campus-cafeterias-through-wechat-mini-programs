<!--pages/search/search.wxml-->
<view class="container">
  <!-- 搜索栏 -->
  <view class="search-header">
    <view class="search-input-box">
      <image class="search-icon" src="{{icons.search}}"></image>
      <input class="search-input" placeholder="请输入菜品名称" value="{{keyword}}" bindinput="onInput" bindconfirm="doSearch" confirm-type="search" focus="true"></input>
      <view class="clear-btn" wx:if="{{keyword}}" bindtap="onClear">
        <image class="clear-icon" src="{{icons.clear}}"></image>
      </view>
    </view>
    <view class="search-btn" bindtap="doSearch">搜索</view>
  </view>

  <!-- 搜索历史 -->
  <view class="history-section" wx:if="{{!searching && history.length > 0}}">
    <view class="section-header">
      <text class="section-title">历史搜索</text>
      <image class="delete-icon" src="{{icons.delete}}" bindtap="clearHistory"></image>
    </view>
    <view class="history-list">
      <view class="history-tag" wx:for="{{history}}" wx:key="*this" bindtap="onHistoryClick" data-text="{{item}}">{{item}}</view>
    </view>
  </view>

  <!-- 搜索结果 -->
  <scroll-view scroll-y class="result-list" wx:if="{{searching}}" bindscrolltolower="onReachBottom">
    <block wx:if="{{searchResults.length > 0}}">
      <view class="dish-item" wx:for="{{searchResults}}" wx:key="id">
        <image class="dish-img" src="{{item.image}}" mode="aspectFill" bindtap="goToDetail" data-id="{{item.id}}"></image>
        <view class="dish-info">
          <view class="dish-name" bindtap="goToDetail" data-id="{{item.id}}">{{item.name}}</view>
          <view class="dish-desc">{{item.description || '暂无描述'}}</view>
          <view class="dish-bottom">
            <view class="dish-price">¥{{item.price}}</view>
            <view class="add-btn" catchtap="addToCart" data-dish="{{item}}">+</view>
          </view>
        </view>
      </view>
      <view class="no-more" wx:if="{{!hasMore}}">没有更多了</view>
    </block>
    <view wx:else class="empty-state">
      <text>未找到相关菜品</text>
    </view>
  </scroll-view>
</view>



