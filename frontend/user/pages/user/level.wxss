/* pages/user/level.wxss */
page {
  background: #f1f5f9;
  min-height: 100vh;
  width: 100%;
  overflow-x: hidden;
}

.container {
  padding: 24rpx;
  padding-bottom: 60rpx;
  width: 100%;
  overflow-x: hidden;
  box-sizing: border-box;
}

/* Level Card */
.level-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: linear-gradient(135deg, #0ea5e9, #0284c7);
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(14, 165, 233, 0.3);
}

.level-icon {
  font-size: 80rpx;
  background: rgba(255, 255, 255, 0.2);
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.level-info {
  flex: 1;
}

.level-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #fff;
  display: block;
  margin-bottom: 16rpx;
}

.level-progress-bar {
  height: 16rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.level-progress {
  height: 100%;
  background: #fff;
  border-radius: 8rpx;
  transition: width 0.5s ease;
}

.level-exp {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* Section */
.section {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1px solid #f1f5f9;
}

/* Benefits List */
.benefits-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.benefit-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  background: #f8fafc;
  border-radius: 12rpx;
  opacity: 0.5;
}

.benefit-item.active {
  opacity: 1;
  background: linear-gradient(135deg, #f0fdf4, #dcfce7);
}

.benefit-icon {
  font-size: 36rpx;
}

.benefit-info {
  flex: 1;
}

.benefit-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1e293b;
  display: block;
  margin-bottom: 4rpx;
}

.benefit-desc {
  font-size: 22rpx;
  color: #64748b;
}

.benefit-level {
  font-size: 22rpx;
  color: #94a3b8;
  padding: 6rpx 12rpx;
  background: #f1f5f9;
  border-radius: 8rpx;
}

.benefit-item.active .benefit-level {
  background: #22c55e;
  color: #fff;
}

/* Level List */
.level-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.level-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  background: #f8fafc;
  border-radius: 12rpx;
}

.level-item.current {
  background: linear-gradient(135deg, #e0f2fe, #bae6fd);
  border: 2rpx solid #0ea5e9;
}

.level-item-icon {
  font-size: 32rpx;
}

.level-item-info {
  flex: 1;
}

.level-item-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
  display: block;
  margin-bottom: 4rpx;
}

.level-item-exp {
  font-size: 22rpx;
  color: #64748b;
}

.level-item-status {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  font-weight: 600;
}

.level-item.current .level-item-status {
  background: #0ea5e9;
  color: #fff;
}

.level-item-status.locked {
  background: #f1f5f9;
  color: #94a3b8;
}

.level-item-status.unlocked {
  background: #d1fae5;
  color: #059669;
}

/* Rules List */
.rules-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.rule-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1px solid #f1f5f9;
}

.rule-item:last-child {
  border-bottom: none;
}

.rule-action {
  font-size: 28rpx;
  color: #475569;
}

.rule-exp {
  font-size: 26rpx;
  color: #0ea5e9;
  font-weight: 700;
}

