<!--pages/user/profile.wxml-->
<view class="container">
  <!-- Avatar Section -->
  <view class="avatar-section" bindtap="changeAvatar">
    <view class="avatar-wrapper">
      <image class="avatar" src="{{userInfo.avatarUrl || defaultAvatar}}" mode="aspectFill"></image>
      <view class="avatar-mask">
        <text>更换头像</text>
      </view>
    </view>
  </view>

  <!-- Form Section -->
  <view class="form-section">
    <!-- Nickname -->
    <view class="form-item" bindtap="editNickname">
      <text class="form-label">昵称</text>
      <view class="form-value">
        <text>{{userInfo.nickName || '未设置'}}</text>
        <text class="arrow">›</text>
      </view>
    </view>

    <!-- Signature -->
    <view class="form-item" bindtap="editSignature">
      <text class="form-label">个性签名</text>
      <view class="form-value">
        <text class="{{userInfo.signature ? '' : 'placeholder'}}">{{userInfo.signature || '未设置'}}</text>
        <text class="arrow">›</text>
      </view>
    </view>

    <!-- Gender -->
    <view class="form-item" bindtap="selectGender">
      <text class="form-label">性别</text>
      <view class="form-value">
        <text>{{genderText}}</text>
        <text class="arrow">›</text>
      </view>
    </view>

    <!-- Phone -->
    <view class="form-item">
      <text class="form-label">手机号</text>
      <view class="form-value">
        <text>{{phoneDisplay}}</text>
      </view>
    </view>
  </view>

  <!-- Level Info -->
  <view class="level-section">
    <view class="section-title">等级信息</view>
    <view class="level-info-card">
      <view class="level-row">
        <text class="level-label">当前等级</text>
        <view class="level-badge">
          <text>{{userLevel.icon}} Lv.{{userLevel.level}} {{userLevel.title}}</text>
        </view>
      </view>
      <view class="level-row">
        <text class="level-label">累计经验</text>
        <text class="level-value">{{userLevel.currentExp}} 点</text>
      </view>
      <view class="level-row">
        <text class="level-label">下级所需</text>
        <text class="level-value">{{userLevel.nextExp - userLevel.currentExp}} 点</text>
      </view>
    </view>
  </view>

  <!-- Exp Rules -->
  <view class="rules-section">
    <view class="section-title">经验获取规则</view>
    <view class="rules-list">
      <view class="rule-item">
        <text class="rule-icon">📝</text>
        <text class="rule-text">发布帖子</text>
        <text class="rule-exp">+20 经验</text>
      </view>
      <view class="rule-item">
        <text class="rule-icon">💬</text>
        <text class="rule-text">评论帖子</text>
        <text class="rule-exp">+5 经验</text>
      </view>
      <view class="rule-item">
        <text class="rule-icon">❤️</text>
        <text class="rule-text">被点赞</text>
        <text class="rule-exp">+2 经验</text>
      </view>
      <view class="rule-item">
        <text class="rule-icon">⭐</text>
        <text class="rule-text">被收藏</text>
        <text class="rule-exp">+3 经验</text>
      </view>
      <view class="rule-item">
        <text class="rule-icon">🛒</text>
        <text class="rule-text">完成订单</text>
        <text class="rule-exp">+10 经验</text>
      </view>
    </view>
  </view>
</view>

<!-- Nickname Edit Modal -->
<view class="modal {{showNicknameModal ? 'show' : ''}}" catchtouchmove="preventMove">
  <view class="modal-mask" bindtap="closeNicknameModal"></view>
  <view class="modal-content">
    <view class="modal-header">
      <text class="modal-title">修改昵称</text>
      <text class="modal-close" bindtap="closeNicknameModal">✕</text>
    </view>
    <input 
      class="modal-input" 
      placeholder="请输入昵称"
      value="{{tempNickname}}"
      bindinput="onNicknameInput"
      maxlength="20"
      focus="{{showNicknameModal}}"
    />
    <view class="modal-footer">
      <text class="char-count">{{tempNickname.length}}/20</text>
      <button class="save-btn" bindtap="saveNickname">保存</button>
    </view>
  </view>
</view>

<!-- Signature Edit Modal -->
<view class="modal {{showSignatureModal ? 'show' : ''}}" catchtouchmove="preventMove">
  <view class="modal-mask" bindtap="closeSignatureModal"></view>
  <view class="modal-content">
    <view class="modal-header">
      <text class="modal-title">修改个性签名</text>
      <text class="modal-close" bindtap="closeSignatureModal">✕</text>
    </view>
    <textarea 
      class="modal-textarea" 
      placeholder="介绍一下自己吧~"
      value="{{tempSignature}}"
      bindinput="onSignatureInput"
      maxlength="50"
      focus="{{showSignatureModal}}"
    ></textarea>
    <view class="modal-footer">
      <text class="char-count">{{tempSignature.length}}/50</text>
      <button class="save-btn" bindtap="saveSignature">保存</button>
    </view>
  </view>
</view>

