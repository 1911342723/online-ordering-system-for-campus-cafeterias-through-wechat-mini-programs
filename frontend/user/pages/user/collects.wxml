<!--pages/user/collects.wxml-->
<view class="container">
  <scroll-view 
    scroll-y 
    class="collect-list" 
    bindscrolltolower="loadMore"
    refresher-enabled="{{true}}"
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh"
  >
    <!-- Empty State -->
    <view class="empty-state" wx:if="{{collects.length === 0 && !loading}}">
      <text class="empty-icon">⭐</text>
      <text class="empty-title">暂无收藏</text>
      <text class="empty-desc">去发现页看看有什么好吃的吧~</text>
      <view class="empty-btn" bindtap="goDiscover">去发现</view>
    </view>

    <!-- Collect Items -->
    <view class="collect-item" wx:for="{{collects}}" wx:key="id" bindtap="goToDetail" data-id="{{item.noteId || item.id}}">
      <image class="collect-image" src="{{item.coverImage}}" mode="aspectFill"></image>
      <view class="collect-info">
        <text class="collect-title">{{item.title}}</text>
        <view class="collect-meta">
          <view class="author-info">
            <image class="author-avatar" src="{{item.userAvatar || defaultAvatar}}"></image>
            <text class="author-name">{{item.userName}}</text>
          </view>
          <text class="collect-time">{{item.collectTimeStr}}</text>
        </view>
      </view>
      <view class="uncollect-btn" catchtap="uncollect" data-id="{{item.noteId || item.id}}">
        <text>取消收藏</text>
      </view>
    </view>

    <!-- Loading -->
    <view class="loading" wx:if="{{loading}}">
      <view class="loading-spinner"></view>
      <text>加载中...</text>
    </view>

    <view class="no-more" wx:if="{{!hasMore && collects.length > 0}}">
      <text>— 没有更多了 —</text>
    </view>
    
    <view class="bottom-spacer"></view>
  </scroll-view>
</view>

