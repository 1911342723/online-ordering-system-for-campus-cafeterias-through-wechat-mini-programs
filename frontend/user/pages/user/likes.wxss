/* pages/user/likes.wxss */
page {
  background: #f1f5f9;
  min-height: 100vh;
  width: 100%;
  overflow-x: hidden;
}

.header-card {
  background: linear-gradient(135deg, #fef2f2, #fee2e2);
  padding: 48rpx;
  margin: 24rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.total-likes {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.likes-num {
  font-size: 72rpx;
  font-weight: 900;
  color: #ef4444;
}

.likes-label {
  font-size: 26rpx;
  color: #dc2626;
  margin-top: 8rpx;
}

.like-list {
  height: calc(100vh - 220rpx);
  padding: 0 24rpx;
}

/* Empty State */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 60rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #64748b;
}

/* Like Item */
.like-item {
  display: flex;
  gap: 16rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #f1f5f9;
  flex-shrink: 0;
}

.like-content {
  flex: 1;
  min-width: 0;
}

.like-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.user-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1e293b;
}

.like-time {
  font-size: 22rpx;
  color: #94a3b8;
}

.like-text {
  font-size: 26rpx;
  color: #64748b;
  margin-bottom: 12rpx;
}

.note-preview {
  padding: 12rpx 16rpx;
  background: #f8fafc;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #475569;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Loading */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 32rpx;
  color: #64748b;
  font-size: 26rpx;
}

.loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid #e2e8f0;
  border-top-color: #ef4444;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.no-more {
  text-align: center;
  padding: 32rpx;
  color: #94a3b8;
  font-size: 24rpx;
}

.bottom-spacer {
  height: 60rpx;
}

