/* pages/user/posts.wxss */
page {
  background: #f1f5f9;
  height: 100vh;
  width: 100%;
  overflow-x: hidden;
}

.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  width: 100%;
  overflow-x: hidden;
  box-sizing: border-box;
}

/* Tabs */
.tabs {
  display: flex;
  background: #fff;
  padding: 0 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 28rpx 0;
  font-size: 28rpx;
  color: #64748b;
  position: relative;
  transition: all 0.2s;
}

.tab.active {
  color: #0ea5e9;
  font-weight: 700;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background: #0ea5e9;
  border-radius: 3rpx;
}

.count {
  font-size: 24rpx;
  color: #94a3b8;
}

.tab.active .count {
  color: #0ea5e9;
}

/* Post List */
.post-list {
  flex: 1;
  padding: 24rpx;
}

/* Empty State */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 60rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #64748b;
  margin-bottom: 32rpx;
}

.empty-btn {
  padding: 20rpx 60rpx;
  background: linear-gradient(135deg, #0ea5e9, #0284c7);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 40rpx;
  box-shadow: 0 8rpx 20rpx rgba(14, 165, 233, 0.3);
}

/* Post Item */
.post-item {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.post-content {
  display: flex;
  gap: 16rpx;
  padding: 20rpx;
}

.post-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f1f5f9;
  flex-shrink: 0;
}

.post-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.post-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1e293b;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.4;
  margin-bottom: 8rpx;
}

.post-desc {
  font-size: 24rpx;
  color: #64748b;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.4;
}

.post-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}

.post-time {
  font-size: 22rpx;
  color: #94a3b8;
}

.post-stats {
  display: flex;
  gap: 16rpx;
  font-size: 22rpx;
  color: #64748b;
}

/* Post Actions */
.post-actions {
  display: flex;
  border-top: 1px solid #f1f5f9;
}

.action-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  font-size: 26rpx;
  font-weight: 600;
  transition: all 0.2s;
}

.action-btn.edit {
  color: #0ea5e9;
  border-right: 1px solid #f1f5f9;
}

.action-btn.delete {
  color: #ef4444;
}

.action-btn:active {
  background: #f8fafc;
}

/* Loading */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 32rpx;
  color: #64748b;
  font-size: 26rpx;
}

.loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid #e2e8f0;
  border-top-color: #0ea5e9;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.no-more {
  text-align: center;
  padding: 32rpx;
  color: #94a3b8;
  font-size: 24rpx;
}

.bottom-spacer {
  height: 140rpx;
}

/* Publish Button */
.publish-btn {
  position: fixed;
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  left: 50%;
  transform: translateX(-50%);
  padding: 24rpx 48rpx;
  background: linear-gradient(135deg, #0ea5e9, #0284c7);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 50rpx;
  box-shadow: 0 8rpx 24rpx rgba(14, 165, 233, 0.4);
  z-index: 100;
}

.publish-btn:active {
  transform: translateX(-50%) scale(0.95);
}

