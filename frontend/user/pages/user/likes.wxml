<!--pages/user/likes.wxml-->
<view class="container">
  <view class="header-card">
    <view class="total-likes">
      <text class="likes-num">{{totalLikes}}</text>
      <text class="likes-label">累计获赞</text>
    </view>
  </view>

  <scroll-view 
    scroll-y 
    class="like-list" 
    bindscrolltolower="loadMore"
    refresher-enabled="{{true}}"
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh"
  >
    <!-- Empty State -->
    <view class="empty-state" wx:if="{{likes.length === 0 && !loading}}">
      <text class="empty-icon">❤️</text>
      <text class="empty-title">暂无获赞</text>
      <text class="empty-desc">发布优质内容，获得更多点赞吧~</text>
    </view>

    <!-- Like Items -->
    <view class="like-item" wx:for="{{likes}}" wx:key="id" bindtap="goToDetail" data-id="{{item.noteId}}">
      <image class="user-avatar" src="{{item.fromUserAvatar || defaultAvatar}}"></image>
      <view class="like-content">
        <view class="like-header">
          <text class="user-name">{{item.fromUserName}}</text>
          <text class="like-time">{{item.createTimeStr}}</text>
        </view>
        <text class="like-text">赞了你的帖子</text>
        <view class="note-preview" wx:if="{{item.noteTitle}}">
          <text>{{item.noteTitle}}</text>
        </view>
      </view>
    </view>

    <!-- Loading -->
    <view class="loading" wx:if="{{loading}}">
      <view class="loading-spinner"></view>
      <text>加载中...</text>
    </view>

    <view class="no-more" wx:if="{{!hasMore && likes.length > 0}}">
      <text>— 没有更多了 —</text>
    </view>
    
    <view class="bottom-spacer"></view>
  </scroll-view>
</view>

