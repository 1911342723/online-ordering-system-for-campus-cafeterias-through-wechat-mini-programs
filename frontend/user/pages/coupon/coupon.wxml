<!-- 我的优惠券页面 -->
<view class="container">
  <view class="tabs">
    <view class="tab {{currentTab==0 ? 'active' : ''}}" bindtap="switchTab" data-index="0">未使用</view>
    <view class="tab {{currentTab==1 ? 'active' : ''}}" bindtap="switchTab" data-index="1">已使用</view>
    <view class="tab {{currentTab==2 ? 'active' : ''}}" bindtap="switchTab" data-index="2">已过期</view>
  </view>

  <view class="coupon-list" wx:if="{{couponList.length > 0}}">
    <view class="coupon-card {{item.status === 'used' ? 'used' : ''}} {{item.status === 'expired' ? 'expired' : ''}}" 
          wx:for="{{couponList}}" 
          wx:key="id">
      <view class="coupon-left">
        <view class="amount-area">
          <text class="symbol">¥</text>
          <text class="amount">{{item.amount}}</text>
        </view>
        <view class="condition">满{{item.minAmount}}可用</view>
      </view>
      <view class="coupon-right">
        <view class="title">{{item.name}}</view>
        <view class="desc">{{item.description}}</view>
        <view class="expire-time">有效期至：{{item.expireTime}}</view>
        <view class="status-tag {{item.status}}">
          <text wx:if="{{item.status === 'unused'}}">未使用</text>
          <text wx:if="{{item.status === 'used'}}">已使用</text>
          <text wx:if="{{item.status === 'expired'}}">已过期</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:else>
    <image class="empty-img" src="data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100' fill='%23CCCCCC'%3E%3Cpath d='M20 30h60v40H20z'/%3E%3Cpath fill='%23FFF' d='M25 35h50v10H25z'/%3E%3Cpath fill='%23FFF' d='M25 50h50v5H25z'/%3E%3Cpath fill='%23FFF' d='M25 60h50v5H25z'/%3E%3C/svg%3E"></image>
    <text class="empty-text">暂无优惠券</text>
    <button class="get-coupon-btn" bindtap="goToCanteenList">去领券</button>
  </view>
</view>

