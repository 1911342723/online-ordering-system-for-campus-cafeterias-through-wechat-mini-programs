<!-- 地址编辑页面 -->
<view class="container">
  <view class="form">
    <!-- 收货人 -->
    <view class="form-item">
      <text class="label required">收货人</text>
      <input class="input" 
             placeholder="请输入收货人姓名" 
             value="{{formData.consignee}}"
             bindinput="onInput"
             data-field="consignee"
             maxlength="20"/>
    </view>

    <!-- 联系电话 -->
    <view class="form-item">
      <text class="label required">联系电话</text>
      <input class="input" 
             type="number"
             placeholder="请输入手机号码" 
             value="{{formData.phone}}"
             bindinput="onInput"
             data-field="phone"
             maxlength="11"/>
    </view>

    <!-- 性别 -->
    <view class="form-item">
      <text class="label">性别</text>
      <view class="gender-group">
        <view class="gender-item {{formData.sex === '1' ? 'active' : ''}}" 
              bindtap="selectGender" 
              data-sex="1">
          <text>男</text>
        </view>
        <view class="gender-item {{formData.sex === '0' ? 'active' : ''}}" 
              bindtap="selectGender" 
              data-sex="0">
          <text>女</text>
        </view>
      </view>
    </view>

    <!-- 地区选择 -->
    <view class="form-item">
      <text class="label required">所在地区</text>
      <picker mode="region" 
              value="{{region}}" 
              bindchange="onRegionChange">
        <view class="picker {{region[0] ? '' : 'placeholder'}}">
          {{region[0] ? region[0] + ' ' + region[1] + ' ' + region[2] : '请选择省市区'}}
        </view>
      </picker>
    </view>

    <!-- 详细地址 -->
    <view class="form-item">
      <text class="label required">详细地址</text>
      <textarea class="textarea" 
                placeholder="街道、门牌号等详细信息" 
                value="{{formData.detail}}"
                bindinput="onInput"
                data-field="detail"
                maxlength="200"
                auto-height/>
    </view>

    <!-- 地址标签 -->
    <view class="form-item">
      <text class="label">地址标签</text>
      <view class="label-group">
        <view class="label-item {{formData.label === '家' ? 'active' : ''}}" 
              bindtap="selectLabel" 
              data-label="家">
          <text>家</text>
        </view>
        <view class="label-item {{formData.label === '公司' ? 'active' : ''}}" 
              bindtap="selectLabel" 
              data-label="公司">
          <text>公司</text>
        </view>
        <view class="label-item {{formData.label === '学校' ? 'active' : ''}}" 
              bindtap="selectLabel" 
              data-label="学校">
          <text>学校</text>
        </view>
        <view class="label-item {{customLabel ? 'active' : ''}}" 
              bindtap="selectLabel" 
              data-label="">
          <text>{{customLabel || '自定义'}}</text>
        </view>
      </view>
      
      <!-- 自定义标签输入 -->
      <input class="input" 
             wx:if="{{customLabel !== null && formData.label !== '家' && formData.label !== '公司' && formData.label !== '学校'}}"
             placeholder="请输入自定义标签" 
             value="{{formData.label}}"
             bindinput="onInput"
             data-field="label"
             maxlength="10"/>
    </view>

    <!-- 设为默认地址 -->
    <view class="form-item switch-item">
      <text class="label">设为默认地址</text>
      <switch checked="{{formData.isDefault === 1}}" 
              bindchange="onDefaultChange"
              color="#FF6B00"/>
    </view>
  </view>
</view>

<!-- 底部按钮 -->
<view class="footer">
  <button class="save-btn" bindtap="saveAddress">保存</button>
</view>

