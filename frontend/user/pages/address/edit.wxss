/* 地址编辑页面样式 */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 120rpx;
}

.form {
  background-color: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 20rpx 30rpx;
}

.form-item {
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-item:last-child {
  border-bottom: none;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 20rpx;
  font-weight: bold;
}

.label.required::before {
  content: '*';
  color: var(--primary-color);
  margin-right: 8rpx;
}

.input,
.textarea,
.picker {
  width: 100%;
  font-size: 28rpx;
  color: #333;
  background-color: #f9f9f9;
  border-radius: 8rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

.input::placeholder,
.textarea::placeholder {
  color: #ccc;
}

.picker.placeholder {
  color: #ccc;
}

.textarea {
  min-height: 120rpx;
  line-height: 1.6;
}

/* 性别选择 */
.gender-group {
  display: flex;
  gap: 20rpx;
}

.gender-item {
  flex: 1;
  background-color: #f9f9f9;
  border: 2rpx solid #f0f0f0;
  border-radius: 8rpx;
  padding: 20rpx;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  transition: all 0.3s;
}

.gender-item.active {
  background-color: #e0f2fe;
  border-color: var(--primary-color);
  color: var(--primary-color);
}

/* 地址标签 */
.label-group {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.label-item {
  background-color: #f9f9f9;
  border: 2rpx solid #f0f0f0;
  border-radius: 8rpx;
  padding: 16rpx 32rpx;
  font-size: 26rpx;
  color: #666;
  transition: all 0.3s;
}

.label-item.active {
  background-color: #e0f2fe;
  border-color: var(--primary-color);
  color: var(--primary-color);
}

/* Switch组件 */
.switch-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.switch-item .label {
  margin-bottom: 0;
}

/* 底部按钮 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  padding: 20rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.save-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, var(--primary-light), var(--primary-color));
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
}

.save-btn::after {
  border: none;
}

