/* 地址列表页面样式 */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 100rpx;
}

.address-list {
  padding: 20rpx;
}

.address-item {
  background-color: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  padding: 30rpx;
  position: relative;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.address-item.default {
  border: 2rpx solid var(--primary-color);
}

.default-tag {
  position: absolute;
  top: 0;
  right: 0;
  background: linear-gradient(135deg, var(--primary-light), var(--primary-color));
  color: #fff;
  padding: 8rpx 20rpx;
  border-radius: 0 16rpx 0 20rpx;
  font-size: 24rpx;
}

.address-info {
  margin-bottom: 20rpx;
}

.consignee-info {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.consignee {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-right: 20rpx;
}

.phone {
  font-size: 28rpx;
  color: #666;
}

.address-detail {
  margin-bottom: 12rpx;
}

.address-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.address-label {
  display: inline-block;
  margin-top: 8rpx;
}

.label-text {
  background-color: #e0f2fe;
  color: var(--primary-color);
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.address-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.action-btn {
  font-size: 26rpx;
  padding: 10rpx 24rpx;
  min-width: 120rpx;
}

.action-btn.edit {
  background-color: var(--primary-color);
  color: #fff;
  border: none;
}

.action-btn.delete {
  background-color: #fff;
  color: var(--primary-color);
  border: 1rpx solid var(--primary-color);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
  opacity: 0.3;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #ccc;
}

/* 底部按钮 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  padding: 20rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.add-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, var(--primary-light), var(--primary-color));
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
}

.add-btn::after {
  border: none;
}

