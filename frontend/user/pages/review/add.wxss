/* pages/review/add.wxss */
.container {
  padding: 30rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.rating-section {
  background: #fff;
  padding: 40rpx;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
}

.stars {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.star {
  font-size: 60rpx;
  color: #FFC107;
}

.rating-text {
  font-size: 28rpx;
  color: #666;
}

.input-section {
  background: #fff;
  padding: 30rpx;
  border-radius: 20rpx;
  margin-bottom: 40rpx;
}

.review-input {
  width: 100%;
  height: 200rpx;
  font-size: 28rpx;
}

.word-count {
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

.submit-btn {
  background: linear-gradient(135deg, #FF6B00, #FF8F3D);
  color: #fff;
  border-radius: 50rpx;
  font-weight: bold;
  border: none;
}

.submit-btn[disabled] {
  background: #ccc;
  color: #fff;
}
