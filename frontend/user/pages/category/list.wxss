/* pages/category/list.wxss */
page {
  background-color: var(--bg-color);
  height: 100vh;
  width: 100%;
  overflow-x: hidden; /* 根源级防止横向溢出 */
}

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  width: 100%;
  overflow-x: hidden;
  box-sizing: border-box;
}

/* ============================================
   Search Header
   ============================================ */
.sticky-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background-color: var(--white);
  width: 100%;
  box-sizing: border-box;
}

.search-header {
  padding: 20rpx 30rpx;
  background-color: var(--white);
}

.search-bar {
  display: flex;
  align-items: center;
  background-color: #f3f4f6;
  border-radius: var(--radius-full);
  padding: 20rpx 30rpx;
  transition: all 0.2s;
}

.search-bar:active {
  background-color: #e5e7eb;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
  opacity: 0.5;
}

.search-placeholder {
  font-size: 28rpx;
  color: var(--text-grey);
}

/* ============================================
   Category Dropdown Trigger - 分类下拉触发器
   ============================================ */
.category-dropdown-trigger {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 30rpx;
  background-color: var(--white);
  border-bottom: 1px solid var(--border-light);
}

.current-category {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.category-icon {
  font-size: 36rpx;
}

.category-text {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-main);
}

.dropdown-arrow {
  font-size: 20rpx;
  color: var(--text-grey);
  transition: transform 0.3s;
}

.dropdown-arrow.up {
  transform: rotate(180deg);
}

/* ============================================
   Category Dropdown Panel - 分类下拉面板
   ============================================ */
.category-dropdown-mask {
  position: fixed;
  inset: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 50;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s;
}

.category-dropdown-mask.show {
  opacity: 1;
  visibility: visible;
}

.category-dropdown-panel {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background-color: var(--white);
  z-index: 51;
  transform: translateY(-100%);
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  border-bottom-left-radius: var(--radius-2xl);
  border-bottom-right-radius: var(--radius-2xl);
  box-shadow: var(--shadow-xl);
  max-height: 70vh;
  overflow-y: auto;
}

.category-dropdown-panel.show {
  transform: translateY(0);
}

.dropdown-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 30rpx;
  border-bottom: 1px solid var(--border-light);
  position: sticky;
  top: 0;
  background-color: var(--white);
  z-index: 1;
}

.dropdown-title {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--text-main);
}

.dropdown-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--text-grey);
  background-color: var(--border-light);
  border-radius: 50%;
}

/* Category Grid - 分类网格 */
.category-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24rpx;
  padding: 30rpx;
}

.category-grid-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 0;
  border-radius: var(--radius-lg);
  transition: all 0.2s;
}

.category-grid-item:active {
  background-color: var(--border-light);
  transform: scale(0.95);
}

.category-grid-item.active {
  background-color: #e0f2fe;
}

.category-grid-item.active .grid-name {
  color: var(--primary-color);
  font-weight: 700;
}

.grid-icon-wrapper {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-xl);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-sm);
}

.grid-icon-wrapper.all {
  background: linear-gradient(135deg, #e0f2fe, #bae6fd);
}

.grid-icon {
  font-size: 40rpx;
}

.grid-name {
  font-size: 24rpx;
  color: var(--text-main);
  font-weight: 500;
}

/* ============================================
   Filter Bar
   ============================================ */
.filter-bar {
  display: flex;
  align-items: center;
  background-color: var(--white);
  padding: 16rpx 24rpx;
  gap: 12rpx;
  border-bottom: 1px solid var(--border-light);
  flex-wrap: nowrap;
  overflow-x: auto;
  width: 100%;
  box-sizing: border-box;
}

/* 隐藏滚动条 */
.filter-bar::-webkit-scrollbar {
  display: none;
}

.filter-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 14rpx 20rpx;
  font-size: 24rpx;
  color: var(--text-sub);
  border-radius: var(--radius-full);
  background-color: #f8fafc;
  transition: all 0.2s;
  white-space: nowrap;
  flex-shrink: 0;
}

.filter-item:active {
  transform: scale(0.96);
}

.filter-item.active {
  color: var(--primary-color);
  background-color: #e0f2fe;
  font-weight: 700;
}

.filter-btn {
  margin-left: auto;
  background-color: transparent;
  border: 1px solid var(--border-color);
}

.filter-btn-icon {
  font-size: 24rpx;
}

.filter-icon {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.6;
}

/* ============================================
   Shop List
   ============================================ */
.shop-list {
  flex: 1;
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx 24rpx;
  overflow-x: hidden; /* 确保列表内部不横向滚动 */
}

/* ============================================
   Empty State
   ============================================ */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  color: var(--text-main);
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty-tip {
  font-size: 26rpx;
  color: var(--text-grey);
}

/* ============================================
   Shop Card - 修复溢出问题
   ============================================ */
.shop-card {
  display: flex;
  gap: 20rpx;
  background-color: var(--white);
  border-radius: var(--radius-xl);
  padding: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-sm);
  border: 1px solid var(--border-light);
  transition: all 0.2s;
  box-sizing: border-box;
  /* 移除强制宽度，依靠 Flex 父容器 padding 自适应 */
  position: relative;
  overflow: hidden;
  min-width: 0; /* 允许 Flex item 收缩 */
}

.shop-card:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-xs);
}

.shop-img-wrapper {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-lg);
  overflow: hidden;
  flex-shrink: 0;
  background-color: #f3f4f6;
}

.shop-img {
  width: 100%;
  height: 100%;
}

.shop-badge {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  background: linear-gradient(135deg, #f59e0b, #fbbf24);
  color: #fff;
  font-size: 18rpx;
  font-weight: 700;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
}

.shop-closed {
  position: absolute;
  inset: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
}

/* 关键修复：shop-info 溢出问题 */
.shop-info {
  flex: 1;
  width: 0; /* 关键修复：强制 flex item 宽度收缩，不被子内容撑开 */
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 8rpx;
  overflow: hidden;
}

.shop-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12rpx;
  max-width: 100%; /* 强制约束 */
}

.shop-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-main);
  line-height: 1.3;
  flex: 1;
  min-width: 0; /* 允许文本截断 */
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.shop-rating {
  display: flex;
  align-items: center;
  gap: 4rpx;
  background: linear-gradient(135deg, #fef3c7, #fde68a);
  padding: 6rpx 10rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}

.rating-star {
  font-size: 20rpx;
  color: #f59e0b;
}

.rating-score {
  font-size: 22rpx;
  font-weight: 700;
  color: #b45309;
}

.shop-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: nowrap;
  overflow: hidden;
  max-width: 100%; /* 强制约束 */
}

.shop-sales,
.shop-distance,
.shop-time {
  font-size: 22rpx;
  color: var(--text-sub);
  white-space: nowrap;
}

.meta-divider {
  color: var(--border-color);
  font-size: 18rpx;
}

.shop-tags {
  display: flex;
  flex-wrap: nowrap;
  gap: 8rpx;
  overflow: hidden;
  max-width: 100%; /* 强制约束 */
}

.shop-tag {
  font-size: 20rpx;
  color: var(--text-sub);
  background-color: #f3f4f6;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-full);
  white-space: nowrap;
  flex-shrink: 0;
}

/* 只显示前3个标签 */
.shop-tag:nth-child(n+4) {
  display: none;
}

.shop-promo {
  display: flex;
  align-items: center;
  gap: 8rpx;
  overflow: hidden;
  max-width: 100%; /* 强制约束 */
}

.promo-badge {
  background: linear-gradient(135deg, #ef4444, #f87171);
  color: #fff;
  font-size: 16rpx;
  font-weight: 700;
  width: 28rpx;
  height: 28rpx;
  border-radius: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.promo-text {
  font-size: 22rpx;
  color: #ef4444;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ============================================
   Loading & No More
   ============================================ */
.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 30rpx 0;
  color: var(--text-grey);
  font-size: 26rpx;
}

.loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid var(--border-color);
  border-top-color: var(--primary-color);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.no-more {
  text-align: center;
  padding: 30rpx 0;
  color: var(--text-grey);
  font-size: 24rpx;
}

.bottom-spacer {
  height: 40rpx;
}

/* ============================================
   Filter Panel
   ============================================ */
.filter-mask {
  position: fixed;
  inset: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 100;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s;
}

.filter-mask.show {
  opacity: 1;
  visibility: visible;
}

.filter-panel {
  position: fixed;
  right: -100%;
  top: 0;
  bottom: 0;
  width: 80%;
  max-width: 600rpx;
  background-color: var(--white);
  z-index: 101;
  display: flex;
  flex-direction: column;
  transition: right 0.3s ease;
}

.filter-panel.show {
  right: 0;
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx 30rpx;
  border-bottom: 1px solid var(--border-light);
}

.panel-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-main);
}

.panel-reset {
  font-size: 28rpx;
  color: var(--primary-color);
  font-weight: 600;
}

.panel-section {
  padding: 30rpx;
  border-bottom: 1px solid var(--border-light);
}

.section-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 20rpx;
  display: block;
}

.filter-options {
  display: flex;
  gap: 16rpx;
}

.filter-options.wrap {
  flex-wrap: wrap;
}

.option-item {
  padding: 16rpx 28rpx;
  font-size: 26rpx;
  color: var(--text-sub);
  background-color: #f3f4f6;
  border-radius: var(--radius-full);
  transition: all 0.2s;
}

.option-item:active {
  transform: scale(0.96);
}

.option-item.active {
  color: var(--primary-color);
  background-color: #e0f2fe;
  font-weight: 600;
}

.panel-footer {
  margin-top: auto;
  display: flex;
  padding: 30rpx;
  gap: 20rpx;
  border-top: 1px solid var(--border-light);
  background-color: var(--white);
}

.btn-cancel,
.btn-confirm {
  flex: 1;
  height: 88rpx;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  transition: all 0.2s;
}

.btn-cancel {
  background-color: #f3f4f6;
  color: var(--text-sub);
}

.btn-cancel:active {
  background-color: #e5e7eb;
}

.btn-confirm {
  background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
  color: #fff;
  box-shadow: var(--shadow-primary);
}

.btn-confirm:active {
  transform: scale(0.98);
}
