<!-- 设置页面 -->
<view class="container">
  <!-- 个人信息 -->
  <view class="section">
    <view class="section-title">个人信息</view>
    <view class="menu-list">
      <view class="menu-item" bindtap="editAvatar">
        <text class="label">头像</text>
        <view class="right">
          <image class="avatar-preview" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
          <text class="arrow">></text>
        </view>
      </view>
      <view class="menu-item" bindtap="editNickname">
        <text class="label">昵称</text>
        <view class="right">
          <text class="value">{{userInfo.nickName}}</text>
          <text class="arrow">></text>
        </view>
      </view>
      <view class="menu-item" bindtap="editGender">
        <text class="label">性别</text>
        <view class="right">
          <text class="value">{{userInfo.sex === '1' ? '男' : userInfo.sex === '2' ? '女' : '未设置'}}</text>
          <text class="arrow">></text>
        </view>
      </view>
      <view class="menu-item">
        <text class="label">手机号</text>
        <view class="right">
          <text class="value">{{userInfo.phone}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 通知设置 -->
  <view class="section">
    <view class="section-title">通知设置</view>
    <view class="menu-list">
      <view class="menu-item">
        <text class="label">订单通知</text>
        <switch checked="{{settings.orderNotify}}" bindchange="onOrderNotifyChange" color="#FF6B00"/>
      </view>
      <view class="menu-item">
        <text class="label">优惠活动通知</text>
        <switch checked="{{settings.promoNotify}}" bindchange="onPromoNotifyChange" color="#FF6B00"/>
      </view>
    </view>
  </view>

  <!-- 其他设置 -->
  <view class="section">
    <view class="section-title">其他</view>
    <view class="menu-list">
      <view class="menu-item" bindtap="clearCache">
        <text class="label">清除缓存</text>
        <view class="right">
          <text class="value">{{cacheSize}}</text>
          <text class="arrow">></text>
        </view>
      </view>
      <view class="menu-item" bindtap="checkUpdate">
        <text class="label">检查更新</text>
        <view class="right">
          <text class="value">v1.0.0</text>
          <text class="arrow">></text>
        </view>
      </view>
      <view class="menu-item" bindtap="showAbout">
        <text class="label">关于我们</text>
        <view class="right">
          <text class="arrow">></text>
        </view>
      </view>
    </view>
  </view>
</view>

