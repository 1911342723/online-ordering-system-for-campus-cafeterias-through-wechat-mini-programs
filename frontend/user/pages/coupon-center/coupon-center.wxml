<!--pages/coupon-center/coupon-center.wxml-->
<view class="container">
  <!-- Header -->
  <view class="header">
    <text class="title">领券中心</text>
    <text class="my-coupons" bindtap="goToMyCoupons">我的优惠券 ></text>
  </view>

  <!-- Coupon List -->
  <view class="coupon-list" wx:if="{{coupons.length > 0}}">
    <view class="coupon-card" wx:for="{{coupons}}" wx:key="id">
      <view class="coupon-main">
        <view class="coupon-left">
          <view class="amount-wrapper">
            <text class="amount">{{item.amount}}</text>
          </view>
          <view class="condition">满{{item.minAmount}}元可用</view>
        </view>
        
        <view class="coupon-middle">
          <view class="coupon-name">{{item.name}}</view>
          <view class="coupon-desc">{{item.description}}</view>
          <view class="coupon-valid">有效期：{{item.validDays}}天</view>
        </view>
        
        <view class="coupon-right">
          <view 
            class="receive-btn {{item.received ? 'received' : ''}}" 
            bindtap="receiveCoupon" 
            data-id="{{item.id}}"
            data-index="{{index}}">
            {{item.received ? '已领取' : '立即领取'}}
          </view>
        </view>
      </view>
      
      <view class="coupon-footer">
        <text class="remain">剩余 {{item.remainCount}} 张</text>
      </view>
    </view>
  </view>

  <!-- Empty State -->
  <view class="empty-state" wx:else>
    <text class="empty-icon">🎫</text>
    <text class="empty-text">暂无可领取的优惠券</text>
    <text class="empty-desc">敬请期待更多优惠活动</text>
  </view>
</view>

