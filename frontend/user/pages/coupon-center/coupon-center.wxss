/* pages/coupon-center/coupon-center.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF5F0 0%, #FFFFFF 40%);
  padding-bottom: 40rpx;
}

/* Header */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx 30rpx 30rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 800;
  color: #1A1A1A;
}

.my-coupons {
  font-size: 26rpx;
  color: #FF6B00;
  font-weight: 600;
}

/* Coupon List */
.coupon-list {
  padding: 0 30rpx;
}

.coupon-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.coupon-main {
  display: flex;
  padding: 32rpx 24rpx;
  position: relative;
}

.coupon-main::after {
  content: '';
  position: absolute;
  right: 180rpx;
  top: 0;
  bottom: 0;
  width: 2rpx;
  background: repeating-linear-gradient(
    to bottom,
    #E5E5E5 0,
    #E5E5E5 8rpx,
    transparent 8rpx,
    transparent 16rpx
  );
}

.coupon-left {
  flex-shrink: 0;
  width: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.amount-wrapper {
  margin-bottom: 12rpx;
}

.amount {
  font-size: 56rpx;
  font-weight: 800;
  color: #FF6B00;
  line-height: 1;
}

.amount::before {
  content: '¥';
  font-size: 36rpx;
  margin-right: 4rpx;
  font-weight: 600;
}

.condition {
  font-size: 22rpx;
  color: #999999;
  text-align: center;
}

.coupon-middle {
  flex: 1;
  padding: 0 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.coupon-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 12rpx;
}

.coupon-desc {
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 12rpx;
  line-height: 1.4;
}

.coupon-valid {
  font-size: 22rpx;
  color: #999999;
}

.coupon-right {
  flex-shrink: 0;
  width: 140rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.receive-btn {
  width: 120rpx;
  height: 60rpx;
  background: linear-gradient(135deg, #FF6B00 0%, #FF8F40 100%);
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 0, 0.3);
}

.receive-btn:active {
  opacity: 0.8;
  transform: scale(0.95);
}

.receive-btn.received {
  background: #E5E5E5;
  color: #999999;
  box-shadow: none;
}

.coupon-footer {
  padding: 16rpx 24rpx;
  background: #F9F9F9;
  border-top: 1rpx solid #F0F0F0;
}

.remain {
  font-size: 22rpx;
  color: #999999;
}

/* Empty State */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 32rpx;
  color: #999999;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #CCCCCC;
}

