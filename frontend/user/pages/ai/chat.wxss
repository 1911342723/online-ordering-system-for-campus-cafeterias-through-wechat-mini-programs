/* pages/ai/chat.wxss */
page {
  background-color: #fff;
}

.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.chat-list {
  flex: 1;
  padding: 40rpx 30rpx;
  box-sizing: border-box;
}

.message {
  display: flex;
  margin-bottom: 40rpx;
  align-items: flex-start;
}

.message.ai {
  justify-content: flex-start;
}

.message.user {
  justify-content: flex-end;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.ai-avatar {
  background: linear-gradient(135deg, #6366F1, #A855F7);
  margin-right: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(99, 102, 241, 0.2);
}

.user-avatar {
  background: #f3f4f6;
  margin-left: 20rpx;
}

.avatar-icon {
  font-size: 36rpx;
}

.bubble-wrapper {
  max-width: 70%;
  display: flex;
  flex-direction: column;
}

.bubble {
  padding: 24rpx 32rpx;
  border-radius: 32rpx;
  font-size: 30rpx;
  line-height: 1.5;
  position: relative;
}

.message.ai .bubble {
  background: #f3f4f6;
  color: #1f2937;
  border-top-left-radius: 8rpx;
}

.message.user .bubble {
  background: var(--primary-color); /* Blue */
  color: #fff;
  border-top-right-radius: 8rpx;
}

.content {
  word-break: break-word;
}

/* Dish Recommendations */
.dish-scroll {
  width: 100%;
  margin-top: 20rpx;
  white-space: nowrap;
}

.dish-list {
  display: inline-flex;
  padding-bottom: 10rpx; /* Space for shadow */
}

.dish-card {
  width: 280rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  margin-right: 20rpx;
  border: 1px solid #eee;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

.dish-img {
  width: 100%;
  height: 200rpx;
  background: #f3f4f6;
}

.dish-info {
  padding: 20rpx;
}

.dish-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2937;
  margin-bottom: 16rpx;
  white-space: normal;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.dish-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.dish-price {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--primary-color);
}

.add-btn {
  width: 48rpx;
  height: 48rpx;
  background: #1f2937;
  border-radius: 50%;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 300;
}

/* Typing Indicator */
.thinking {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 30rpx 32rpx;
}

.typing-dot {
  width: 12rpx;
  height: 12rpx;
  background: #9ca3af;
  border-radius: 50%;
  animation: bounce 1.4s infinite ease-in-out both;
}

.typing-dot:nth-child(1) { animation-delay: -0.32s; }
.typing-dot:nth-child(2) { animation-delay: -0.16s; }

@keyframes bounce {
  0%, 80%, 100% { transform: scale(0); }
  40% { transform: scale(1); }
}

/* Suggestion Chips */
.suggestion-chips {
  padding: 0 30rpx 30rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  padding: 16rpx 32rpx;
  background: #fff;
  border: 1px solid #e5e7eb;
  border-radius: 100rpx;
  font-size: 26rpx;
  color: #4b5563;
  font-weight: 600;
  transition: all 0.2s;
}

.chip:active {
  background: #f3f4f6;
  transform: scale(0.98);
}

/* Input Area */
.input-area {
  padding: 20rpx 30rpx;
  background: #fff;
  border-top: 1px solid #f3f4f6;
}

.safe-area-bottom {
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.input-wrapper {
  background: #f3f4f6;
  border-radius: 44rpx;
  padding: 10rpx 10rpx 10rpx 36rpx;
  display: flex;
  align-items: center;
}

.chat-input {
  flex: 1;
  height: 80rpx;
  font-size: 30rpx;
  color: #1f2937;
}

.send-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #d1d5db;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
}

.send-btn.active {
  background: var(--primary-color);
  color: #fff;
  transform: scale(1.05);
}

.send-icon {
  font-weight: 800;
  font-size: 36rpx;
  color: #fff;
}
