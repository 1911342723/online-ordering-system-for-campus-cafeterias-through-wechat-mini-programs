/* pages/ai/chat.wxss */
page {
  background-color: var(--bg-color);
}

.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.chat-list {
  flex: 1;
  padding: 30rpx 20rpx;
  overflow-y: scroll;
  box-sizing: border-box;
  padding-bottom: 140rpx;
}

.message {
  display: flex;
  margin-bottom: 40rpx;
  align-items: flex-start;
}

/* AI消息：头像在左边 */
.message.ai {
  flex-direction: row;
  justify-content: flex-start;
}

/* 用户消息：头像也在左边，消息靠右 */
.message.user {
  flex-direction: row;
  justify-content: flex-end;
}

/* Avatar Styles */
.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: var(--shadow-sm);
}

.ai-avatar {
  background: var(--white);
  padding: 0rpx;
  margin-right: 24rpx;
}

.avatar-icon {
  width: 60rpx;
  height: 60rpx;
}

.user-avatar {
  background: linear-gradient(135deg, #1A1A1A, #333333);
  color: #fff;
  font-size: 40rpx;
  margin-left: 24rpx;
  order: 2;
}

/* Bubble Styles */
.bubble {
  max-width: 520rpx;
  padding: 24rpx 32rpx;
  border-radius: 24rpx;
  font-size: 30rpx;
  line-height: 1.6;
  box-shadow: var(--shadow-sm);
  word-wrap: break-word;
  position: relative;
}

.message.ai .bubble {
  background-color: var(--white);
  color: var(--text-main);
  border-top-left-radius: 6rpx;
}

.message.user .bubble {
  background: linear-gradient(135deg, #FF7A30, #FF5000);
  color: #fff;
  border-top-right-radius: 6rpx;
  order: 1;
}

.content {
  display: block;
  white-space: pre-wrap;
  word-break: break-word;
}

/* Dish Recommendations - Horizontal Scroll */
.dish-scroll {
  margin-top: 24rpx;
  width: 100%;
  white-space: nowrap;
}

.dish-list {
  display: inline-flex;
  flex-direction: row;
  padding-bottom: 10rpx;
}

.dish-card {
  background: #F8F9FA;
  border-radius: 20rpx;
  padding: 16rpx;
  display: inline-flex;
  flex-direction: column;
  border: 1rpx solid #f0f0f0;
  width: 220rpx;
  margin-right: 20rpx;
  box-sizing: border-box;
  flex-shrink: 0;
}

.dish-card:last-child {
  margin-right: 0;
}

.dish-img {
  width: 100%;
  height: 180rpx;
  border-radius: 16rpx;
  background-color: #eee;
  object-fit: cover;
}

.dish-info {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
}

.dish-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 8rpx;
  white-space: normal;
  word-break: break-word;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.3;
  height: 68rpx;
}

.dish-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 8rpx;
}

.dish-price {
  font-size: 30rpx;
  color: var(--primary-color);
  font-weight: 800;
}

.dish-price::before {
  content: '¥';
  font-size: 22rpx;
  margin-right: 2rpx;
  font-weight: normal;
}

.add-btn {
  width: 48rpx;
  height: 48rpx;
  background: var(--text-main);
  border-radius: 50%;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 300;
  line-height: 44rpx;
}

/* AI Thinking Dots */
.thinking {
  padding: 20rpx 28rpx;
}

.dots {
  display: flex;
  align-items: center;
  height: 40rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  background: #999;
  border-radius: 50%;
  margin: 0 6rpx;
  animation: jump 1.4s infinite ease-in-out both;
}

.dot:nth-child(1) { animation-delay: -0.32s; }
.dot:nth-child(2) { animation-delay: -0.16s; }

@keyframes jump {
  0%, 80%, 100% { transform: scale(0); }
  40% { transform: scale(1); }
}

/* Quick Questions */
.quick-questions {
  padding: 20rpx 30rpx 30rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  background-color: var(--bg-color);
}

.quick-item {
  background: var(--white);
  padding: 20rpx 28rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: var(--primary-color);
  border: 2rpx solid rgba(255, 80, 0, 0.2);
  box-shadow: var(--shadow-sm);
  font-weight: 600;
}

/* Input Area */
.input-area {
  background-color: var(--white);
  padding: 24rpx 30rpx;
  display: flex;
  align-items: center;
  border-top: 1rpx solid #f0f0f0;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.04);
}

.input {
  flex: 1;
  height: 88rpx;
  background-color: #F2F3F5;
  border-radius: 44rpx;
  padding: 0 36rpx;
  font-size: 30rpx;
  margin-right: 24rpx;
  color: var(--text-main);
}

.send-btn {
  width: 140rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #FF7A30, #FF5000);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
  padding: 0;
  margin: 0;
  box-shadow: 0 4rpx 12rpx rgba(255, 80, 0, 0.3);
}

.send-btn[disabled] {
  background: #E0E0E0;
  color: #fff;
  box-shadow: none;
}
