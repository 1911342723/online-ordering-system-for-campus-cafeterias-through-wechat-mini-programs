/* 余额充值页面样式 */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 120rpx;
}

/* 余额显示 */
.balance-section {
  background: linear-gradient(135deg, #FF6B00, #FF8F3D);
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 50rpx 30rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 0, 0.3);
}

.balance-label {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 16rpx;
}

.balance-amount {
  font-size: 72rpx;
  font-weight: bold;
  color: #fff;
}

/* 充值金额选择 */
.amount-section {
  background-color: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
}

.amount-list {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.amount-item {
  aspect-ratio: 2/1;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
}

.amount-item.active {
  border-color: #FF6B00;
  background-color: #FFF3E0;
}

.amount-item .amount {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.amount-item.active .amount {
  color: #FF6B00;
}

/* 自定义金额 */
.custom-amount {
  border-top: 1rpx solid #f0f0f0;
  padding-top: 30rpx;
}

.custom-amount .label {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 16rpx;
}

.input-wrapper {
  display: flex;
  align-items: center;
  background-color: #f9f9f9;
  border-radius: 12rpx;
  padding: 20rpx;
}

.currency {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-right: 12rpx;
}

.amount-input {
  flex: 1;
  font-size: 32rpx;
  color: #333;
}

/* 支付方式 */
.payment-section {
  background-color: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
}

.payment-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 20rpx;
  border: 2rpx solid #f0f0f0;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  transition: all 0.3s;
}

.payment-item:last-child {
  margin-bottom: 0;
}

.payment-item.active {
  border-color: #FF6B00;
  background-color: #FFF3E0;
}

.payment-left {
  display: flex;
  align-items: center;
}

.payment-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.payment-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.payment-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #ccc;
  position: relative;
}

.payment-item.active .payment-check {
  border-color: #FF6B00;
  background-color: #FF6B00;
}

.payment-item.active .payment-check::after {
  content: '✓';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
}

/* 底部充值按钮 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  padding: 20rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.total-info {
  flex: 1;
}

.total-info .label {
  font-size: 26rpx;
  color: #666;
  margin-right: 8rpx;
}

.total-info .price {
  font-size: 40rpx;
  font-weight: bold;
  color: #FF6B00;
}

.recharge-btn {
  width: 240rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #FF6B00, #FF8F3D);
  color: #fff;
  border-radius: 40rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
  line-height: 80rpx;
  padding: 0;
}

.recharge-btn::after {
  border: none;
}

