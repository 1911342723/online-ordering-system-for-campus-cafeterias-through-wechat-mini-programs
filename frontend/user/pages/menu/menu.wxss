/* pages/menu/menu.wxss */
page {
  background-color: #f8fafc;
  height: 100vh;
  overflow: hidden;
}

.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

/* ============================================
   Merchant Header - 高级磨砂头图
   ============================================ */
.header-bg {
  height: 260rpx;
  position: relative;
  overflow: hidden;
}

.header-bg-img {
  width: 100%;
  height: 100%;
  filter: blur(20rpx);
  transform: scale(1.2);
}

.header-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, rgba(0,0,0,0.3), rgba(0,0,0,0.6));
}

.merchant-card {
  margin: -140rpx 24rpx 20rpx;
  background: var(--white);
  border-radius: var(--radius-xl);
  padding: 32rpx;
  position: relative;
  z-index: 10;
  box-shadow: var(--shadow-lg);
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.merchant-main {
  display: flex;
  gap: 24rpx;
}

.merchant-logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-lg);
  border: 2rpx solid var(--border-light);
  box-shadow: var(--shadow-sm);
  flex-shrink: 0;
}

.merchant-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.merchant-name {
  font-size: 36rpx;
  font-weight: 900;
  color: var(--text-main);
  margin-bottom: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.merchant-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.meta-tag {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #b45309;
  background: #fef3c7;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
}

.meta-text {
  font-size: 22rpx;
  color: var(--text-sub);
}

.merchant-notice {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 8rpx;
}

.notice-icon {
  font-size: 24rpx;
}

.notice-text {
  flex: 1;
  font-size: 22rpx;
  color: var(--text-grey);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.notice-arrow {
  font-size: 24rpx;
  color: var(--text-light);
}

/* 联系商家按钮 */
.contact-merchant-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 12rpx;
  padding: 12rpx 20rpx;
  background: linear-gradient(135deg, #e0f2fe, #bae6fd);
  border-radius: 24rpx;
  width: fit-content;
}

.contact-icon {
  font-size: 24rpx;
}

.contact-text {
  font-size: 24rpx;
  color: #0284c7;
  font-weight: 600;
}

/* Coupons */
.coupon-list {
  padding-top: 20rpx;
  border-top: 1px dashed var(--border-light);
}

.coupon-scroll {
  white-space: nowrap;
  width: 100%;
}

.coupon-item {
  display: inline-flex;
  align-items: center;
  background: linear-gradient(135deg, #fff1f2, #ffe4e6);
  border: 1px solid #fecdd3;
  border-radius: var(--radius-sm);
  padding: 8rpx 16rpx;
  margin-right: 16rpx;
  position: relative;
}

.coupon-item::before, .coupon-item::after {
  content: '';
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 12rpx;
  height: 12rpx;
  background-color: var(--white);
  border-radius: 50%;
  border: 1px solid #fecdd3;
}

.coupon-item::before { left: -6rpx; border-right-color: transparent; }
.coupon-item::after { right: -6rpx; border-left-color: transparent; }

.coupon-left {
  display: flex;
  align-items: baseline;
  color: #e11d48;
  margin-right: 12rpx;
}

.coupon-left .symbol {
  font-size: 20rpx;
  font-weight: 700;
}

.coupon-left .amount {
  font-size: 32rpx;
  font-weight: 900;
}

.coupon-right {
  display: flex;
  flex-direction: column;
}

.coupon-right .condition {
  font-size: 18rpx;
  color: #be123c;
}

.coupon-right .action {
  font-size: 18rpx;
  color: #e11d48;
  font-weight: 700;
}

.coupon-right .action.disabled {
  color: var(--text-grey);
}

/* ============================================
   Menu Layout
   ============================================ */
.menu-container {
  flex: 1;
  display: flex;
  overflow: hidden;
  background-color: var(--white);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.05);
}

/* Sidebar */
.sidebar {
  width: 180rpx;
  background-color: #f8fafc;
  height: 100%;
  flex-shrink: 0; /* 防止侧边栏被压缩 */
}

.sidebar-item {
  padding: 32rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  transition: all 0.2s;
}

.sidebar-name {
  font-size: 26rpx;
  color: var(--text-sub);
  text-align: center;
  line-height: 1.4;
}

.sidebar-item.active {
  background-color: var(--white);
}

.sidebar-item.active .sidebar-name {
  font-weight: 800;
  color: var(--text-main);
}

.sidebar-item.active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 32rpx;
  background-color: var(--primary-color);
  border-radius: 0 4rpx 4rpx 0;
}

.category-badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  background-color: #ef4444;
  color: white;
  font-size: 18rpx;
  min-width: 28rpx;
  height: 28rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 6rpx;
  font-weight: 700;
}

.sidebar-spacer {
  height: 150rpx;
}

/* Dish List */
.dish-scroll {
  flex: 1;
  width: 0; /* 关键修复：防止 flex 子项被内容撑开超出屏幕 */
  height: 100%;
  background-color: var(--white);
}

.category-section {
  padding-bottom: 20rpx;
}

.category-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-main);
  padding: 24rpx 24rpx 12rpx;
  background-color: var(--white);
  position: sticky;
  top: 0;
  z-index: 1;
}

.dish-item {
  display: flex;
  padding: 24rpx;
  gap: 24rpx;
  position: relative;
  box-sizing: border-box; /* 确保 padding 不会撑大宽度 */
  width: 100%;
}

.dish-img {
  width: 180rpx;
  height: 180rpx;
  border-radius: var(--radius-lg);
  background-color: #f1f5f9;
  flex-shrink: 0;
}

.dish-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.dish-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 8rpx;
}

.dish-desc {
  font-size: 22rpx;
  color: var(--text-grey);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-bottom: 8rpx;
}

.dish-sales {
  font-size: 20rpx;
  color: var(--text-sub);
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.divider {
  color: var(--border-color);
}

.dish-footer {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-top: 12rpx;
}

.price-box {
  display: flex;
  align-items: baseline;
}

.price-box .currency {
  font-size: 24rpx;
  color: #ef4444;
  font-weight: 700;
}

.price-box .price {
  font-size: 36rpx;
  color: #ef4444;
  font-weight: 900;
  margin-right: 12rpx;
}

.price-box .original-price {
  font-size: 22rpx;
  color: var(--text-light);
  text-decoration: line-through;
}

/* Add Button */
.add-action {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.btn-minus, .btn-add {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 36rpx;
  line-height: 1; /* 关键：重置行高 */
  transition: all 0.2s;
  position: relative;
  padding-bottom: 4rpx; /* 微调垂直居中 */
}

/* 隐形点击区域扩大 */
.btn-minus::after, .btn-add::after {
  content: '';
  position: absolute;
  top: -16rpx;
  left: -16rpx;
  right: -16rpx;
  bottom: -16rpx;
}

.btn-minus {
  border: 2rpx solid var(--border-color);
  color: var(--text-sub);
  background-color: var(--white);
}

.btn-minus:active {
  background-color: #f1f5f9;
}

.btn-add {
  background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
  color: white;
  box-shadow: 0 4rpx 12rpx rgba(14, 165, 233, 0.3);
}

.btn-add:active {
  transform: scale(0.9);
}

.cart-num {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-main);
  min-width: 32rpx;
  text-align: center;
}

.list-spacer {
  height: 180rpx;
}

/* ============================================
   Cart Bar
   ============================================ */
.cart-bar-wrapper {
  position: fixed;
  bottom: 40rpx;
  left: 24rpx;
  right: 24rpx;
  z-index: 100;
  padding-bottom: env(safe-area-inset-bottom);
}

.cart-bar {
  background: #1e293b;
  height: 100rpx;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-right: 6rpx;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.25);
  position: relative;
}

.cart-bar.disabled {
  background: #334155;
}

.cart-left {
  flex: 1;
  display: flex;
  align-items: center;
  height: 100%;
}

.cart-icon-box {
  width: 96rpx;
  height: 96rpx;
  background: #1e293b;
  border-radius: 50%;
  position: relative;
  top: -20rpx;
  left: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 8rpx solid #f8fafc;
}

.cart-icon-box.disabled {
  background: #334155;
  border-color: #f8fafc;
}

.cart-img {
  width: 56rpx;
  height: 56rpx;
}

.cart-badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  background: #ef4444;
  color: white;
  font-size: 20rpx;
  font-weight: 700;
  min-width: 36rpx;
  height: 36rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
  border: 2rpx solid #1e293b;
}

.cart-info {
  margin-left: 40rpx;
  display: flex;
  flex-direction: column;
}

.cart-total {
  color: #fff;
  display: flex;
  align-items: baseline;
}

.cart-total .currency {
  font-size: 24rpx;
  margin-right: 4rpx;
}

.cart-total .amount {
  font-size: 40rpx;
  font-weight: 700;
}

.delivery-tip {
  font-size: 20rpx;
  color: #94a3b8;
}

.empty-tip {
  margin-left: 40rpx;
  font-size: 28rpx;
  color: #94a3b8;
  font-weight: 600;
}

.cart-right {
  height: 88rpx;
  padding: 0 48rpx;
  background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  transition: all 0.2s;
}

.cart-right:active {
  transform: scale(0.96);
}

.cart-right.disabled {
  background: transparent;
  color: #94a3b8;
  font-size: 26rpx;
}

/* ============================================
   商家微信社群二维码弹窗
   ============================================ */
.qrcode-modal {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: none;
}

.qrcode-modal.show {
  display: block;
}

.qrcode-mask {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
}

.qrcode-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.qrcode-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.qrcode-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #1e293b;
}

.qrcode-close {
  font-size: 40rpx;
  color: #94a3b8;
  padding: 10rpx;
}

.qrcode-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
}

.qrcode-img {
  width: 400rpx;
  height: 400rpx;
  border-radius: 16rpx;
  border: 4rpx solid #f1f5f9;
  margin-bottom: 24rpx;
}

.qrcode-hint {
  font-size: 28rpx;
  color: #64748b;
  margin-bottom: 24rpx;
}

.qrcode-desc {
  font-size: 26rpx;
  color: #1e293b;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.qrcode-benefits {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  align-items: flex-start;
  width: 100%;
  padding: 20rpx 32rpx;
  background: #f8fafc;
  border-radius: 12rpx;
}

.qrcode-benefits text {
  font-size: 24rpx;
  color: #64748b;
}

.qrcode-footer {
  margin-top: 32rpx;
}

.save-qrcode-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #0ea5e9, #0284c7);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}
