/* pages/menu/menu.wxss */
.container {
  height: 100vh;
  overflow: hidden;
  background-color: #fff;
}

.header {
  height: 100rpx;
  background-color: #333;
  color: #fff;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.canteen-name {
  font-size: 34rpx;
  font-weight: bold;
}

.header-info {
  font-size: 22rpx;
  color: #ccc;
  margin-top: 10rpx;
}
.info-item {
  margin-right: 10rpx;
}

.content {
  flex: 1;
  display: flex;
  height: calc(100vh - 200rpx); /* Adjust for header and cart bar */
}

.category-sidebar {
  width: 180rpx;
  background-color: #f8f8f8;
  height: 100%;
}

.category-item {
  padding: 30rpx 20rpx;
  font-size: 26rpx;
  color: #666;
  border-bottom: 1rpx solid #eee;
  text-align: center;
}

.category-item.active {
  background-color: #fff;
  color: #333;
  font-weight: bold;
  border-left: 6rpx solid var(--primary-color);
}

.food-list {
  flex: 1;
  height: 100%;
  background-color: #fff;
}

.category-header {
  padding: 20rpx;
  font-size: 26rpx;
  font-weight: bold;
  color: #666;
  background-color: #fcfcfc;
}

.food-item {
  display: flex;
  padding: 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.food-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  background-color: #eee;
  margin-right: 20rpx;
}

.food-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.food-name {
  font-size: 30rpx;
  font-weight: bold;
}

.food-desc {
  font-size: 22rpx;
  color: #999;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.food-sales {
  font-size: 22rpx;
  color: #666;
}

.price-action {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.price {
  font-size: 32rpx;
  color: #e4393c;
  font-weight: bold;
}

.action-btn {
  display: flex;
  align-items: center;
}

.minus-btn, .add-btn {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  text-align: center;
  line-height: 40rpx;
  font-weight: bold;
}

.minus-btn {
  border: 2rpx solid #ccc;
  color: #666;
}

.add-btn {
  background-color: var(--primary-color);
  color: #fff;
}

.count {
  margin: 0 16rpx;
  font-size: 28rpx;
}

.cart-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100rpx;
  background-color: #333;
  display: flex;
  align-items: center;
  z-index: 100;
}

.cart-icon-wrapper {
  position: relative;
  width: 100rpx;
  height: 100rpx;
  background-color: #333;
  border-radius: 50%;
  margin-top: -40rpx;
  margin-left: 30rpx;
  border: 10rpx solid #444;
  display: flex;
  justify-content: center;
  align-items: center;
}

.cart-icon {
  width: 60rpx;
  height: 60rpx;
}

.badge {
  position: absolute;
  top: 0;
  right: 0;
  background-color: #e4393c;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 10rpx;
  border-radius: 20rpx;
}

.cart-price {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-left: 30rpx;
  color: #fff;
}

.total {
  font-size: 36rpx;
  font-weight: bold;
}

.delivery-fee {
  font-size: 20rpx;
  color: #999;
}

.pay-btn {
  background-color: var(--primary-color);
  color: #fff;
  height: 100%;
  padding: 0 60rpx;
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: bold;
}

.cart-bar.empty {
  opacity: 0.9;
}

.empty-text {
  color: #999;
  margin-left: 30rpx;
}

