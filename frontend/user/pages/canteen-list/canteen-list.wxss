.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx;
}

.canteen-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.canteen-item {
  display: flex;
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
  position: relative;
}

.canteen-item:active {
  opacity: 0.9;
  transform: scale(0.99);
}

.canteen-image {
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
}

.canteen-info {
  flex: 1;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.canteen-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.canteen-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.status-badge {
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.status-badge.open {
  background: #E8F5E9;
  color: #4CAF50;
}

.status-badge.closed {
  background: #FFEBEE;
  color: #F44336;
}

.canteen-desc {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.canteen-meta {
  display: flex;
  gap: 24rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #666;
}

.star {
  font-size: 24rpx;
  margin-right: 4rpx;
}

.icon {
  margin-right: 4rpx;
}

.arrow-icon {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 48rpx;
  color: #ddd;
}

.empty {
  text-align: center;
  padding: 200rpx 0;
  color: #999;
  font-size: 28rpx;
}

