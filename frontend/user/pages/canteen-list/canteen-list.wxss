/* pages/canteen-list/canteen-list.wxss */
page {
  background-color: var(--bg-color); /* #f0f9ff */
  min-height: 100vh;
}

.container {
  min-height: 100vh;
  padding: 30rpx;
}

.canteen-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.canteen-item {
  display: flex;
  background: var(--white);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  position: relative;
  transition: all 0.2s;
  border: 1px solid #f3f4f6;
}

.canteen-item:active {
  transform: scale(0.98);
  box-shadow: none;
}

.canteen-image {
  width: 220rpx;
  height: 220rpx;
  flex-shrink: 0;
  background-color: #f3f4f6;
}

.canteen-info {
  flex: 1;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.canteen-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.canteen-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-main);
  line-height: 1.2;
}

.status-badge {
  padding: 6rpx 16rpx;
  border-radius: 100rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.status-badge.open {
  background: rgba(52, 211, 153, 0.1); /* Green 100 */
  color: #059669; /* Green 600 */
}

.status-badge.closed {
  background: rgba(156, 163, 175, 0.1);
  color: #6b7280;
}

.canteen-desc {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.canteen-meta {
  display: flex;
  gap: 24rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: var(--text-grey);
}

.star {
  font-size: 24rpx;
  margin-right: 6rpx;
  color: var(--accent-color);
}

.icon {
  margin-right: 6rpx;
}

.arrow-icon {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 40rpx;
  color: #e5e7eb;
  font-weight: 300;
}

.empty {
  text-align: center;
  padding: 200rpx 0;
  color: var(--text-grey);
  font-size: 28rpx;
}
