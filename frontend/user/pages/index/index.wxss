/* pages/index/index.wxss */
page {
  background-color: var(--bg-color);
}

.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom);
}

/* Header */
.header {
  padding: 20rpx 30rpx;
  background-color: var(--white);
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.02);
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.location-wrapper {
  display: flex;
  align-items: center;
  background: #F2F3F5;
  padding: 10rpx 20rpx;
  border-radius: 32rpx;
}

.icon-location {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
}

.location-text {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-right: 8rpx;
}

.arrow-down {
  width: 0;
  height: 0;
  border-left: 6rpx solid transparent;
  border-right: 6rpx solid transparent;
  border-top: 8rpx solid #666;
  margin-top: 2rpx;
}

.scan-btn {
  display: flex;
  align-items: center;
  background: var(--text-main);
  padding: 10rpx 24rpx;
  border-radius: 32rpx;
}

.icon-scan {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
  filter: brightness(0) invert(1); /* Make icon white */
}

.scan-btn text {
  font-size: 26rpx;
  color: #fff;
  font-weight: 500;
}

/* Search Bar */
.search-bar {
  background-color: #F2F3F5;
  border-radius: 32rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  transition: all 0.3s;
}

.search-bar:active {
  background-color: #EAEBEC;
}

.icon-search {
  width: 36rpx;
  height: 36rpx;
  margin-right: 20rpx;
  opacity: 0.5;
}

.placeholder {
  font-size: 28rpx;
  color: #999;
}

/* Main Scroll */
.main-scroll {
  flex: 1;
}

/* Banner */
.banner-wrapper {
  padding: 24rpx 30rpx 0;
  background-color: transparent;
}

.banner {
  height: 320rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.08);
  transform: translateY(0);
}

.banner-item {
  width: 100%;
  height: 100%;
  border-radius: 24rpx;
  overflow: hidden;
}

.banner-img {
  width: 100%;
  height: 100%;
}

/* Announcements */
.announcement-section {
  background-color: var(--white);
  margin: 24rpx 30rpx;
  border-radius: 16rpx;
  overflow: hidden;
  height: 88rpx;
  box-shadow: var(--shadow-sm);
}

.announcement-swiper {
  height: 100%;
}

.announcement-item {
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  height: 100%;
}

.announcement-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.announcement-content {
  flex: 1;
  display: flex;
  align-items: center;
  overflow: hidden;
}

.announcement-type {
  font-size: 22rpx;
  color: var(--primary-color);
  background-color: rgba(255, 80, 0, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  font-weight: 600;
}

.announcement-title {
  font-size: 28rpx;
  color: var(--text-main);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.announcement-arrow {
  font-size: 28rpx;
  color: #ccc;
  margin-left: 12rpx;
  flex-shrink: 0;
}

/* AI Entry - Hero Section */
.ai-entry {
  margin: 0 30rpx 30rpx;
  background: linear-gradient(120deg, #2B32B2 0%, #1488CC 100%);
  /* Or a warm gradient if preferred, but let's try a premium tech blue/purple contrast to the orange app */
  background: linear-gradient(135deg, #1A1A1A 0%, #333333 100%); /* Premium Black */
  border-radius: 24rpx;
  padding: 40rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.15);
  position: relative;
  overflow: hidden;
}

.ai-entry::before {
  content: '';
  position: absolute;
  right: -40rpx;
  top: -40rpx;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0) 70%);
  border-radius: 50%;
}

.ai-entry::after {
  content: '';
  position: absolute;
  left: -20rpx;
  bottom: -20rpx;
  width: 120rpx;
  height: 120rpx;
  background: radial-gradient(circle, rgba(255, 80, 0, 0.2) 0%, rgba(255, 80, 0, 0) 70%);
  border-radius: 50%;
}

.ai-left {
  flex: 1;
  z-index: 1;
}

.ai-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.ai-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  margin-right: 16rpx;
  letter-spacing: 1rpx;
}

.ai-tag {
  background: linear-gradient(90deg, #FF5000, #FF8F40);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 800;
  box-shadow: 0 2rpx 8rpx rgba(255, 80, 0, 0.4);
}

.ai-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.ai-right {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(10px);
  border-radius: 50%;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  z-index: 1;
}

.ai-icon-img {
  width: 64rpx;
  height: 64rpx;
}

/* Section */
.section {
  margin-top: 20rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 30rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-main);
  position: relative;
  padding-left: 20rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 32rpx;
  background: var(--primary-color);
  border-radius: 4rpx;
}

.section-more {
  font-size: 26rpx;
  color: var(--text-sub);
  display: flex;
  align-items: center;
}

/* Today's Recommendations Section - 今日推荐板块 */
.today-recommend-section {
  margin: 24rpx 0;
  background-color: transparent;
}

.today-recommend-section .section-header {
  padding: 0 30rpx;
  margin-bottom: 24rpx;
}

.today-recommend-section .section-more {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.today-recommend-section .arrow-icon {
  font-size: 32rpx;
  font-weight: 300;
}

.recommendation-scroll {
  white-space: nowrap;
}

.recommendation-list {
  display: inline-flex;
  padding: 0 30rpx 20rpx;
}

.recommendation-card {
  display: inline-block;
  width: 320rpx;
  background-color: var(--white);
  border-radius: 24rpx;
  overflow: hidden;
  margin-right: 24rpx;
  box-shadow: var(--shadow-md);
  transition: all 0.3s ease;
}

.recommendation-card:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-sm);
}

.recommendation-img {
  width: 100%;
  height: 240rpx;
  background: linear-gradient(135deg, #f5f5f5 0%, #e8e8e8 100%);
  object-fit: cover;
}

.recommendation-info {
  padding: 24rpx;
}

.dish-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-main);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-bottom: 12rpx;
  line-height: 1.2;
}

.dish-meta {
  margin-bottom: 20rpx;
  display: flex;
}

.category-name {
  font-size: 22rpx;
  color: var(--text-sub);
  background-color: #F2F3F5;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.price {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--primary-color);
  letter-spacing: -0.5rpx;
}

.add-btn {
  width: 56rpx;
  height: 56rpx;
  background: linear-gradient(135deg, #FF7A30, #FF5000);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 36rpx;
  font-weight: 300;
  box-shadow: 0 4rpx 12rpx rgba(255, 80, 0, 0.3);
  transition: all 0.2s;
}

.add-btn:active {
  transform: scale(0.9);
  box-shadow: 0 2rpx 6rpx rgba(255, 80, 0, 0.2);
}

/* Canteen List */
.canteen-list {
  padding: 0 30rpx 30rpx;
}

.canteen-card {
  background: var(--white);
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  display: flex;
  box-shadow: var(--shadow-sm);
  padding: 20rpx;
}

.card-img-wrapper {
  width: 200rpx;
  height: 200rpx;
  position: relative;
  flex-shrink: 0;
  border-radius: 16rpx;
  overflow: hidden;
}

.canteen-img {
  width: 100%;
  height: 100%;
}

.status-badge {
  position: absolute;
  top: 0;
  left: 0;
  padding: 6rpx 16rpx;
  font-size: 20rpx;
  border-bottom-right-radius: 16rpx;
  color: #fff;
  font-weight: 600;
  backdrop-filter: blur(4px);
}

.status-badge.open {
  background: rgba(52, 211, 153, 0.9); /* Green */
}

.status-badge.closed {
  background: rgba(156, 163, 175, 0.9); /* Grey */
}

.canteen-info {
  flex: 1;
  padding-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.info-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.canteen-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 8rpx;
}

.distance-badge {
  font-size: 22rpx;
  color: var(--primary-color);
  background-color: rgba(255, 80, 0, 0.08);
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.rating-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.icon-star {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
}

.score {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--accent-color);
  margin-right: 16rpx;
}

.sales {
  font-size: 24rpx;
  color: #999;
}

.tags-row {
  display: flex;
  flex-wrap: wrap;
}

.tag {
  font-size: 20rpx;
  color: #666;
  background-color: #F2F3F5;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
  margin-bottom: 6rpx;
}

.footer-spacer {
  height: 60rpx;
}

/* Coupon Center Entry */
.coupon-center-entry {
  margin: 24rpx 30rpx;
  background: linear-gradient(135deg, #FF6B00 0%, #FF8F40 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 0, 0.25);
  position: relative;
  overflow: hidden;
}

.coupon-center-entry::before {
  content: '';
  position: absolute;
  right: -60rpx;
  top: -60rpx;
  width: 240rpx;
  height: 240rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}

.coupon-center-entry::after {
  content: '';
  position: absolute;
  left: -40rpx;
  bottom: -40rpx;
  width: 160rpx;
  height: 160rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
}

.entry-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  z-index: 1;
}

.entry-icon {
  font-size: 60rpx;
  line-height: 1;
}

.entry-content {
  display: flex;
  flex-direction: column;
}

.entry-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #FFFFFF;
  margin-bottom: 8rpx;
  letter-spacing: 1rpx;
}

.entry-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 500;
}

.entry-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
  z-index: 1;
}

.entry-coupons {
  display: flex;
  gap: 8rpx;
}

.mini-coupon {
  background: rgba(255, 255, 255, 0.25);
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  border-radius: 8rpx;
  padding: 6rpx 12rpx;
  backdrop-filter: blur(10rpx);
}

.mini-amount {
  font-size: 20rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.entry-arrow {
  display: flex;
  align-items: center;
  gap: 4rpx;
  background: #FFFFFF;
  color: #FF6B00;
  font-size: 24rpx;
  font-weight: 700;
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
}

.entry-arrow .arrow {
  font-size: 32rpx;
  font-weight: 300;
}

.coupon-center-entry:active {
  transform: scale(0.98);
  opacity: 0.9;
}

/* Coupon Dialog */
.coupon-dialog-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.coupon-dialog {
  position: relative;
  width: 640rpx;
  background: linear-gradient(180deg, #FF8F40 0%, #FF6B00 100%);
  border-radius: 32rpx;
  padding: 48rpx 32rpx 32rpx;
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from {
    transform: translateY(100rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.dialog-close {
  position: absolute;
  right: 20rpx;
  top: 20rpx;
  width: 56rpx;
  height: 56rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #FFFFFF;
  font-weight: 300;
}

.dialog-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #FFFFFF;
  text-align: center;
  margin-bottom: 12rpx;
}

.dialog-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  text-align: center;
  margin-bottom: 32rpx;
}

.dialog-coupons {
  margin-bottom: 32rpx;
}

.dialog-coupon-item {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.dialog-coupon-item:last-child {
  margin-bottom: 0;
}

.dialog-coupon-left {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 24rpx;
  padding-right: 24rpx;
  border-right: 2rpx dashed #E5E5E5;
  min-width: 140rpx;
}

.dialog-coupon-amount {
  font-size: 48rpx;
  font-weight: 800;
  color: #FF6B00;
  line-height: 1;
  letter-spacing: -1rpx;
}

.dialog-coupon-condition {
  font-size: 20rpx;
  color: #999999;
  margin-top: 8rpx;
}

.dialog-coupon-right {
  flex: 1;
}

.dialog-coupon-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 8rpx;
}

.dialog-coupon-desc {
  font-size: 22rpx;
  color: #666666;
}

.dialog-btn {
  width: 100%;
  height: 88rpx;
  background: #FFFFFF;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #FF6B00;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.dialog-btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}