/* pages/index/index.wxss */
/* 高级设计版本 - 参考 Font Awesome + 美团风格 */

page {
  background: linear-gradient(180deg, var(--bg-color) 0%, #e0f2fe 100%);
}

.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* ============================================
   Header - 精致顶栏
   ============================================ */
.header {
  padding: 24rpx 30rpx;
  background: var(--white);
  position: sticky;
  top: 0;
  z-index: 100;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: var(--shadow-md);
}

/* 顶部高光线 */
.header::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(14, 165, 233, 0.2), transparent);
}

.header-left {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.icon-location {
  width: 36rpx;
  height: 36rpx;
}

.location-text {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--text-main);
  letter-spacing: -0.5rpx;
}

.arrow-down {
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-top: 12rpx solid var(--text-grey);
  margin-top: 4rpx;
  margin-left: 4rpx;
}

.scan-btn-circle {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--white), #f8fafc);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-md);
  border: 2rpx solid var(--border-light);
  transition: all 0.2s;
}

.scan-btn-circle:active {
  transform: scale(0.92);
  box-shadow: var(--shadow-sm);
}

.icon-scan-white {
  width: 44rpx;
  height: 44rpx;
}

/* ============================================
   Search Bar
   ============================================ */
.search-wrapper {
  padding: 16rpx 30rpx 20rpx;
  background: linear-gradient(180deg, var(--white) 0%, transparent 100%);
}

.search-bar {
  background: var(--white);
  border-radius: var(--radius-full);
  height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 36rpx;
  box-shadow: var(--shadow-md);
  border: 2rpx solid var(--border-light);
  transition: all 0.2s;
}

.search-bar:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-sm);
  border-color: var(--primary-light);
}

.icon-search {
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
  opacity: 0.5;
}

.placeholder {
  font-size: 28rpx;
  color: var(--text-grey);
}

/* ============================================
   Banner - 精美轮播
   ============================================ */
.banner-section {
  padding: 0 30rpx;
  margin-top: 8rpx;
}

.banner-swiper {
  height: 300rpx;
}

.banner-card {
  width: 100%;
  height: 100%;
  border-radius: var(--radius-2xl);
  position: relative;
  overflow: hidden;
  box-shadow: var(--shadow-xl);
  background: linear-gradient(135deg, var(--primary-color) 0%, #06b6d4 50%, var(--primary-dark) 100%);
}

.banner-bg-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

.banner-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, rgba(0,0,0,0.5) 0%, rgba(0,0,0,0.1) 50%, transparent 100%);
  z-index: 2;
}

.banner-content {
  position: relative;
  z-index: 3;
  padding: 40rpx 44rpx;
  color: #fff;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
}

.new-badge {
  background: rgba(255, 255, 255, 0.95);
  color: var(--primary-dark);
  font-size: 20rpx;
  font-weight: 900;
  padding: 8rpx 16rpx;
  border-radius: var(--radius-sm);
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
  letter-spacing: 1rpx;
}

.banner-title {
  font-size: 52rpx;
  font-weight: 900;
  margin-bottom: 12rpx;
  text-shadow: 0 4rpx 12rpx rgba(0,0,0,0.25);
  letter-spacing: -1rpx;
}

.banner-subtitle {
  font-size: 28rpx;
  opacity: 0.95;
  font-weight: 500;
}

/* ============================================
   Category Grid - 金刚区
   ============================================ */
.category-section {
  padding: 28rpx;
  background: var(--white);
  margin: 24rpx 30rpx;
  border-radius: var(--radius-2xl);
  box-shadow: var(--shadow-lg);
  position: relative;
  overflow: hidden;
}

/* 卡片高光 */
.category-section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.9), transparent);
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 0;
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  border-radius: var(--radius-lg);
}

.category-item:active {
  transform: scale(0.92);
  background: var(--border-light);
}

.category-icon-wrapper {
  width: 104rpx;
  height: 104rpx;
  border-radius: var(--radius-xl);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-md);
  transition: all 0.25s;
  position: relative;
  overflow: hidden;
}

/* 图标容器高光 */
.category-icon-wrapper::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 50%;
  background: linear-gradient(180deg, rgba(255,255,255,0.3), transparent);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
}

.category-item:active .category-icon-wrapper {
  transform: scale(1.1);
  box-shadow: var(--shadow-lg);
}

.category-icon {
  font-size: 48rpx;
  position: relative;
  z-index: 1;
}

.category-name {
  font-size: 24rpx;
  color: var(--text-main);
  font-weight: 700;
}

.more-categories {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1px solid var(--border-light);
}

.more-text {
  font-size: 26rpx;
  color: var(--primary-color);
  font-weight: 700;
}

.more-arrow {
  font-size: 28rpx;
  color: var(--primary-color);
}

/* ============================================
   AI Section - 智能推荐
   ============================================ */
.ai-section {
  padding: 24rpx 30rpx;
  margin-top: 8rpx;
}

.ai-card {
  background: var(--white);
  border-radius: var(--radius-2xl);
  padding: 32rpx;
  border: 2rpx solid #f3e8ff;
  box-shadow: var(--shadow-lg);
  position: relative;
  overflow: hidden;
  transition: all 0.2s;
}

.ai-card:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-md);
}

.ai-deco-circle {
  position: absolute;
  top: -30rpx;
  right: -30rpx;
  width: 140rpx;
  height: 140rpx;
  background: linear-gradient(135deg, #faf5ff, #f3e8ff);
  border-radius: 0 0 0 100%;
  z-index: 0;
}

.ai-content {
  position: relative;
  z-index: 1;
}

.ai-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.ai-icon-text {
  font-size: 36rpx;
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.7; transform: scale(1.1); }
}

.ai-title {
  font-size: 32rpx;
  font-weight: 900;
  background: linear-gradient(135deg, #7e22ce, #a855f7);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.ai-desc {
  font-size: 26rpx;
  color: var(--text-sub);
  margin-bottom: 24rpx;
  display: block;
}

.ai-input-mock {
  display: flex;
  gap: 16rpx;
}

.ai-placeholder {
  flex: 1;
  background: linear-gradient(135deg, #faf5ff, #f3e8ff);
  border: 2rpx solid #e9d5ff;
  border-radius: var(--radius-lg);
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  color: var(--text-grey);
}

.ai-btn {
  background: linear-gradient(135deg, #a855f7, #7c3aed);
  color: white;
  padding: 0 36rpx;
  border-radius: var(--radius-lg);
  font-size: 28rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(168, 85, 247, 0.35);
  transition: all 0.2s;
}

.ai-btn:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 12rpx rgba(168, 85, 247, 0.3);
}

/* ============================================
   Coupon Entry
   ============================================ */
.coupon-entry {
  margin: 0 30rpx 24rpx;
  background: var(--white);
  border-radius: var(--radius-xl);
  padding: 28rpx;
  display: flex;
  align-items: center;
  box-shadow: var(--shadow-md);
  border: 2rpx solid var(--border-light);
  transition: all 0.2s;
}

.coupon-entry:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-sm);
}

.coupon-icon-wrapper {
  width: 88rpx;
  height: 88rpx;
  background: linear-gradient(135deg, #fff7ed, #fed7aa);
  border-radius: var(--radius-xl);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-right: 24rpx;
  box-shadow: var(--shadow-sm);
}

.coupon-text {
  flex: 1;
}

.coupon-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--text-main);
  display: block;
  margin-bottom: 6rpx;
}

.coupon-desc {
  font-size: 24rpx;
  color: var(--primary-color);
  background: linear-gradient(135deg, #e0f2fe, #bae6fd);
  padding: 6rpx 14rpx;
  border-radius: var(--radius-sm);
  font-weight: 600;
}

.coupon-arrow {
  color: var(--text-grey);
  font-size: 36rpx;
  font-weight: 300;
}

/* ============================================
   Section Header
   ============================================ */
.section-stalls {
  padding: 24rpx 30rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title-large {
  font-size: 40rpx;
  font-weight: 900;
  color: var(--text-main);
  letter-spacing: -1rpx;
}

.section-more {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 26rpx;
  color: var(--text-grey);
  padding: 8rpx 16rpx;
  background: var(--border-light);
  border-radius: var(--radius-full);
  transition: all 0.2s;
}

.section-more:active {
  background: var(--border-color);
}

.section-more-arrow {
  font-size: 24rpx;
}

/* ============================================
   Stall Card - 门店卡片
   ============================================ */
.stall-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.stall-card {
  background: var(--white);
  border-radius: var(--radius-xl);
  padding: 24rpx;
  display: flex;
  gap: 24rpx;
  box-shadow: var(--shadow-md);
  border: 1px solid var(--border-light);
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  animation: fadeIn 0.4s ease-out;
  position: relative;
  overflow: hidden;
}

/* 卡片高光 */
.stall-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.8), transparent);
}

.stall-card:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-sm);
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.stall-card:nth-child(1) { animation-delay: 0.05s; }
.stall-card:nth-child(2) { animation-delay: 0.1s; }
.stall-card:nth-child(3) { animation-delay: 0.15s; }
.stall-card:nth-child(4) { animation-delay: 0.2s; }
.stall-card:nth-child(5) { animation-delay: 0.25s; }
.stall-card:nth-child(6) { animation-delay: 0.3s; }

.stall-img-box {
  width: 180rpx;
  height: 180rpx;
  border-radius: var(--radius-lg);
  overflow: hidden;
  position: relative;
  background: linear-gradient(135deg, #f1f5f9, #e2e8f0);
  flex-shrink: 0;
  box-shadow: var(--shadow-sm);
}

.stall-img {
  width: 100%;
  height: 100%;
}

.stall-closed-mask {
  position: absolute;
  inset: 0;
  background: rgba(15, 23, 42, 0.6);
  backdrop-filter: blur(4rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 26rpx;
  font-weight: 800;
}

.stall-badge {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  background: linear-gradient(135deg, #f59e0b, #fbbf24);
  color: #fff;
  font-size: 20rpx;
  font-weight: 800;
  padding: 6rpx 14rpx;
  border-radius: var(--radius-sm);
  box-shadow: 0 4rpx 12rpx rgba(245, 158, 11, 0.4);
}

.stall-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 180rpx;
  padding: 4rpx 0;
}

.stall-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.stall-name {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--text-main);
  line-height: 1.2;
  flex: 1;
  margin-right: 12rpx;
  letter-spacing: -0.5rpx;
}

.stall-rating-box {
  background: linear-gradient(135deg, #fef3c7, #fde68a);
  padding: 8rpx 14rpx;
  border-radius: var(--radius-sm);
  box-shadow: var(--shadow-sm);
}

.stall-rating {
  font-size: 24rpx;
  font-weight: 800;
  color: #b45309;
}

.stall-distance {
  font-size: 22rpx;
  color: var(--primary-color);
  background: linear-gradient(135deg, #e0f2fe, #bae6fd);
  padding: 6rpx 14rpx;
  border-radius: var(--radius-sm);
  font-weight: 700;
}

.stall-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.stall-sales {
  font-size: 24rpx;
  color: var(--text-sub);
  font-weight: 500;
}

.stall-divider {
  color: var(--border-color);
  font-size: 20rpx;
}

.stall-distance-text {
  font-size: 24rpx;
  color: var(--primary-color);
  font-weight: 600;
}

.stall-wait {
  font-size: 24rpx;
  color: var(--text-sub);
}

.stall-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.stall-tag {
  font-size: 22rpx;
  color: var(--text-sub);
  background: linear-gradient(135deg, #f8fafc, #f1f5f9);
  padding: 8rpx 16rpx;
  border-radius: var(--radius-full);
  font-weight: 500;
}

.footer-spacer {
  height: 140rpx;
}

/* ============================================
   Coupon Dialog
   ============================================ */
.coupon-dialog-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.6);
  backdrop-filter: blur(8rpx);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.3s ease;
}

.coupon-dialog {
  width: 85%;
  background: linear-gradient(180deg, var(--primary-color) 0%, var(--primary-dark) 100%);
  border-radius: var(--radius-2xl);
  padding: 48rpx 36rpx;
  position: relative;
  box-shadow: var(--shadow-xl);
  animation: slideUp 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes slideUp {
  from { opacity: 0; transform: translateY(40rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.dialog-close {
  position: absolute;
  top: 20rpx;
  right: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  font-size: 48rpx;
  font-weight: 300;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dialog-title {
  font-size: 44rpx;
  font-weight: 900;
  color: #fff;
  text-align: center;
  margin-bottom: 12rpx;
}

.dialog-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  text-align: center;
  margin-bottom: 32rpx;
}

.dialog-coupons {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.dialog-coupon-item {
  background: rgba(255, 255, 255, 0.95);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.dialog-coupon-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-right: 20rpx;
  border-right: 2rpx dashed var(--border-color);
}

.dialog-coupon-amount {
  font-size: 48rpx;
  font-weight: 900;
  color: var(--primary-color);
}

.dialog-coupon-condition {
  font-size: 22rpx;
  color: var(--text-grey);
}

.dialog-coupon-right {
  flex: 1;
}

.dialog-coupon-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 6rpx;
}

.dialog-coupon-desc {
  font-size: 24rpx;
  color: var(--text-sub);
}

.dialog-btn {
  background: rgba(255, 255, 255, 0.95);
  color: var(--primary-dark);
  font-size: 32rpx;
  font-weight: 800;
  padding: 28rpx;
  border-radius: var(--radius-full);
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.dialog-btn:active {
  transform: scale(0.98);
}
